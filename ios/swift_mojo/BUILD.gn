import("//brave/build/ios/create_xcframework.gni")
import("//brave/build/ios/swift_framework.gni")

ios_swift_framework_bundle("swift_mojo_framework") {
  output_name = "SwiftMojo"
  output_dir = root_out_dir
  info_plist = "Info.plist"
  swift_module_target = "//brave/ios/mojo/swift"

  # Provides the implementation of //brave/ios/browser/mojo:headers.
  deps = [ "//brave/ios:brave_core_ios_framework+link" ]
  frameworks = [ "Foundation.framework" ]
}

ios_create_xcframework("swift_mojo_xcframework") {
  framework_dir = "$root_build_dir/SwiftMojo.framework"
  deps = [ ":swift_mojo_framework" ]
}
