<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>playlist.folderItemCountFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld elemente</string>
			<key>one</key>
			<string>%lld element</string>
			<key>other</key>
			<string>%lld elemente</string>
		</dict>
	</dict>
	<key>playlistFolders.subtitleItemCountFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld elemente</string>
			<key>one</key>
			<string>%lld element</string>
			<key>other</key>
			<string>%lld elemente</string>
		</dict>
	</dict>
	<key>tabGrid.tabsCountFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tabs@</string>
		<key>tabs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld File</string>
			<key>one</key>
			<string>%lld Fila</string>
			<key>other</key>
			<string>%lld File</string>
		</dict>
	</dict>
</dict>
</plist>
