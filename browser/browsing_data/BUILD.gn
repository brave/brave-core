import("//brave/components/ai_chat/core/common/buildflags/buildflags.gni")
import("//brave/components/containers/buildflags/buildflags.gni")

source_set("clear_browsing_data") {
  sources = [
    "brave_clear_browsing_data.cc",
    "brave_clear_browsing_data.h",
  ]

  deps = [
    "//base",
    "//brave/components/ai_chat/core/common/buildflags",
    "//brave/components/containers/buildflags",
    "//chrome/browser:browser_process",
    "//chrome/browser/browsing_data:constants",
    "//chrome/browser/lifetime",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//components/browsing_data/core",
    "//components/history/core/common",
    "//components/prefs",
    "//content/public/browser",
  ]

  if (enable_containers) {
    deps += [
      "//brave/browser/containers",
      "//brave/components/containers/core/common",
    ]
  }
}

source_set("browser_tests") {
  testonly = true

  if (!is_android) {
    sources = [
      "//brave/browser/browsing_data/brave_browsing_data_remover_browsertest.cc",
      "//brave/browser/browsing_data/brave_clear_browsing_data_browsertest.cc",
    ]

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    deps = [
      ":clear_browsing_data",
      "//base",
      "//base/test:test_support",
      "//chrome/app:command_ids",
      "//chrome/browser",
      "//chrome/browser/browsing_data:constants",
      "//chrome/browser/search_engines",
      "//chrome/common:constants",
      "//chrome/test:test_support",
      "//chrome/test/base:browser_test_waiters",
      "//chrome/test/base:in_process_browser_test",
      "//chrome/test/base:testing_browser_process",
      "//chrome/test/base:ui_test_utils",
      "//components/browsing_data/core",
      "//components/prefs",
      "//content/public/browser",
      "//content/public/common",
      "//content/test:test_support",
    ]
  }
}
