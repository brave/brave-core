<!-- The landscape variants declare the same ids through
     @layout/customize_brave_landscape_content, which lint cannot see across <include>. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="InconsistentLayout,RtlHardcoded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/onboarding_main_container_horizontal_margin">

    <TextView
        android:id="@+id/brave_onboarding_title"
        style="@style/HeadingH2"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/customize_brave"
        android:textColor="@color/text_primary"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/onboarding_title_margin_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/brave_onboarding_subtitle"
        style="@style/LargeRegular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/customize_brave_subtitle"
        android:textColor="@color/text_secondary"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/onboarding_subtitle_margin_top"
        app:layout_constraintTop_toBottomOf="@+id/brave_onboarding_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/onboarding_illustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/onboarding_illustration_margin_top"
        android:src="@drawable/onboarding_appearance_customizer"
        android:background="@drawable/onboarding_rounded_corners"
        android:padding="@dimen/onboarding_illustration_padding"
        android:contentDescription="@string/brave_onboarding_customize_brave_illustration_description"
        app:layout_constraintTop_toBottomOf="@+id/brave_onboarding_subtitle"
        app:layout_constraintBottom_toTopOf="@+id/onboarding_left_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/onboarding_left_button"
        android:layout_width="0dp"
        android:layout_gravity="center_horizontal"
        style="@style/LargeOutlineButton"
        android:layout_marginVertical="@dimen/onboarding_buttons_vertical_margin"
        android:layout_marginRight="4dp"
        app:layout_constraintTop_toBottomOf="@+id/onboarding_illustration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/onboarding_right_button" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/onboarding_right_button"
        android:layout_width="0dp"
        android:layout_gravity="center_horizontal"
        style="@style/LargeFilledButton"
        android:layout_marginVertical="@dimen/onboarding_buttons_vertical_margin"
        android:layout_marginLeft="4dp"
        app:layout_constraintTop_toBottomOf="@+id/onboarding_illustration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/onboarding_left_button"
        app:layout_constraintRight_toRightOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
