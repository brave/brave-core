source_set("image_metadata_stripper") {
  sources = [
    "file_upload_controller.cc",
    "file_upload_controller.h",
  ]

  public_deps = [
    "//base",
    "//brave/components/image_metadata_stripper",
    "//chrome/browser/ui/tabs:tabs_public",
    "//ui/base/unowned_user_data",
  ]

