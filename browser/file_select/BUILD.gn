source_set("file_select") {
  sources = [
    "brave_file_select_image_metadata_stripper.cc",
    "brave_file_select_image_metadata_stripper.h",
  ]

  public_deps = [
    "//base",
    "//third_party/blink/public/mojom:mojom_platform_headers",
  ]

  deps = [
    "//brave/components/image_metadata_stripper",
    "//brave/components/image_metadata_stripper/common",
    "//content/public/browser",
  ]
}

source_set("browser_tests") {
  testonly = true

  sources = [ "brave_file_select_image_metadata_stripper_browsertest.cc" ]

  deps = [
    ":file_select",
    "//base",
    "//base/test:test_support",
    "//brave/components/image_metadata_stripper/common",
    "//chrome/browser/ui",
    "//chrome/browser/ui/tabs",
    "//chrome/browser/ui/tabs:tab_enums",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//testing/gtest",
    "//ui/shell_dialogs",
    "//ui/shell_dialogs:test_support",
    "//url",
  ]

  data = [ "//brave/test/data/image_metadata_stripper/" ]

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
}
