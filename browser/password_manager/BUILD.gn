if (!is_android) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "password_manager_browsertest.cc" ]

    deps = [
      "//brave/browser",
      "//chrome/browser",
      "//chrome/browser/password_manager/factories",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//content/test:test_support",
    ]
  }

  source_set("unit_tests") {
    testonly = true

    sources = [ "brave_password_manager_client_unittest.cc" ]

    deps = [
      "//base",
      "//brave/components/constants",
      "//chrome/browser/password_manager",
      "//chrome/browser/password_manager/factories",
      "//chrome/browser/sync:factories",
      "//chrome/browser/ui/autofill",
      "//chrome/test:test_support",
      "//chrome/test/base:chrome_render_view_host_test_harness",
      "//components/autofill/core/common:test_support",
      "//components/keyed_service/core",
      "//components/password_manager/core/browser",
      "//components/password_manager/core/browser:test_support",
      "//components/password_manager/core/browser/password_store:test_support",
      "//components/prefs",
      "//components/sync:test_support",
      "//content/public/browser",
      "//testing/gmock",
      "//testing/gtest",
      "//url",
    ]
  }
}
