import("//brave/components/brave_wallet/common/buildflags/buildflags.gni")

assert(!is_android)

source_set("hid") {
  sources = [
    "brave_hid_delegate.cc",
    "brave_hid_delegate.h",
  ]

  public_deps = [
    "//chrome/browser/hid",
    "//content/public/browser",
    "//content/public/common",
  ]

  deps = [ "//brave/components/brave_wallet/common/buildflags" ]

  if (enable_brave_wallet) {
    deps += [ "//brave/browser/brave_wallet:brave_wallet_hid_chooser" ]
  }
}
