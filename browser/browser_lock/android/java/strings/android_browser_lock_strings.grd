<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="values/android_browser_lock_strings.xml" lang="en" type="android" />
  </outputs>
  <release seq="1">
    <messages fallback_to_english="true">
      <message name="IDS_BRAVE_BROWSER_LOCK_UNLOCK_BUTTON" desc="Button label to unlock the browser via biometrics.">
        Unlock browser
      </message>
      <message name="IDS_BRAVE_BROWSER_LOCKED" desc="Status label shown on the browser-wide lock screen.">
        Browser locked
      </message>
      <!-- Duplicated from android_brave_strings.grd: also used by
           BraveMainPreferencesBase.java/brave_main_preferences.xml, which stay part of
           chrome_java and so cannot resolve a string owned by this module. -->
      <message name="IDS_BRAVE_BROWSER_LOCK_SETTINGS_TITLE" desc="Title for the browser biometrics lock setting.">
        Browser lock
      </message>
      <message name="IDS_BRAVE_BROWSER_LOCK_SETTINGS_SCREEN_DESCRIPTION" desc="Description at the top of the Browser Lock settings screen.">
        Lock private tabs or the entire Brave app with your device's screen lock
      </message>
      <message name="IDS_BRAVE_BROWSER_LOCK_WHAT_TO_LOCK" desc="Section header on the Browser Lock settings screen.">
        What to lock
      </message>
      <message name="IDS_BRAVE_BROWSER_LOCK_ENTIRE_APPLICATION" desc="Toggle label: lock the entire Brave application.">
        Entire application
      </message>
      <message name="IDS_BRAVE_BROWSER_LOCK_PRIVATE_TABS" desc="Toggle label: lock private tabs.">
        Private tabs
      </message>
      <message name="IDS_BRAVE_BROWSER_LOCK_SCREEN_CAPTURE" desc="Section header on the Browser Lock settings screen, above the screenshot/video capture toggle.">
        Screen capture
      </message>
      <message name="IDS_BRAVE_BROWSER_LOCK_SCREENSHOT_ALLOW" desc="Radio option label: do not block screenshots or screen recording anywhere in the browser.">
        Allow screenshots
      </message>
      <message name="IDS_BRAVE_BROWSER_LOCK_SCREENSHOT_PRIVATE_TABS_ONLY" desc="Radio option label: block screenshots and screen recording only while a private tab is showing.">
        Block screenshots only on private tabs
      </message>
      <message name="IDS_BRAVE_BROWSER_LOCK_SCREENSHOT_EVERYTHING" desc="Radio option label: block screenshots and screen recording everywhere in the browser.">
        Block screenshots everywhere
      </message>
    </messages>
  </release>
</grit>
