<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="values/android_browser_lock_strings.xml" lang="en" type="android" />
  </outputs>
  <release seq="1">
    <messages fallback_to_english="true">
      <message name="IDS_BRAVE_BROWSER_LOCK_UNLOCK_BUTTON" desc="Button label to unlock the browser via biometrics.">
        Unlock browser
      </message>
      <message name="IDS_BRAVE_BROWSER_LOCKED" desc="Status label shown on the browser-wide lock screen.">
        Browser locked
      </message>
    </messages>
  </release>
</grit>
