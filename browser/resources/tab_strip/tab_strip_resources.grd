<?xml version="1.0" encoding="utf-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/tab_strip_resources.h" type="rc_header" context="default_100_percent">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/tab_strip_resources_map.cc" type="resource_map_source" context="default_100_percent" />
    <output filename="grit/tab_strip_resources_map.h" type="resource_map_header" context="default_100_percent" />
    <output filename="tab_strip_resources_100_percent.pak" type="data_package" context="default_100_percent" />
    <output filename="tab_strip_resources_200_percent.pak" type="data_package" context="default_200_percent" />
  </outputs>
  <release seq="1">
    <structures fallback_to_low_resolution="true">
      <if expr="toolkit_views">
        <structure type="chrome_scaled_image" name="IDR_TAB_DROP_UP" file="tab_drop_up.png" />
      </if>
    </structures>
  </release>
</grit>
