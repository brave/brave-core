import("//brave/resources/brave_grit.gni")
import("//ui/webui/resources/tools/generate_grd.gni")

static_grd_path = "$target_gen_dir/notes_static_resources.grd"

generate_grd("static_resources_grd") {
  grd_prefix = "notes_static"
  out_grd = static_grd_path
  input_files = [
    "browser/ui/webui/side_panel/notes/resources/notes.html",
    "browser/ui/webui/side_panel/notes/resources/notes.js",
    "browser/ui/webui/side_panel/notes/resources/notes.css",
  ]
  input_files_base_dir = rebase_path("../../..", "//")
}

brave_grit("pack_static_resources") {
  source = static_grd_path
  outputs = [
    "grit/notes_static_resources.h",
    "grit/notes_static_resources_map.cc",
    "grit/notes_static_resources_map.h",
    "notes_static_resources.pak",
  ]
  deps = [ ":static_resources_grd" ]
}
