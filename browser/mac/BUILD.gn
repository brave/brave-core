import("//brave/build/config.gni")

assert(enable_sparkle)

# `sparkle_glue` itself is built as part of //chrome/browser.
source_set("test_support") {
  testonly = true

  sources = [
    "fake_sparkle.h",
    "fake_sparkle.mm",
  ]

  deps = [ "//chrome/browser" ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "sparkle_glue_unittest.mm" ]

  deps = [
    ":test_support",
    "//base/test:test_support",
    "//chrome/browser",
    "//testing/gtest",
  ]
}
