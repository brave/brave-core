import("//brave/components/request_otr/common/buildflags/buildflags.gni")

if (!is_android) {
  source_set("infobars") {
    sources = [
      "brave_confirm_infobar_creator.h",
      "brave_confirm_p3a_infobar_delegate.h",
      "brave_sync_account_deleted_infobar_delegate.h",
      "sync_cannot_run_infobar_delegate.h",
    ]

    public_deps = [
      "//base",
      "//brave/components/infobars/core",
      "//components/infobars/core",
      "//url",
    ]

    if (enable_request_otr) {
      sources += [ "request_otr_infobar_delegate.h" ]
    }
  }

  # CreateBraveConfirmInfoBar() is implemented in //brave/browser/ui, not here.
  source_set("impl") {
    visibility = [ "//brave/browser:core" ]

    sources = [
      "brave_confirm_p3a_infobar_delegate.cc",
      "brave_sync_account_deleted_infobar_delegate.cc",
      "sync_cannot_run_infobar_delegate.cc",
    ]

    public_deps = [ ":infobars" ]

    deps = [
      "//base",
      "//brave/app:brave_generated_resources_grit",
      "//brave/common",
      "//brave/components/brave_sync:features",
      "//brave/components/brave_sync:prefs",
      "//brave/components/constants",
      "//brave/components/p3a",
      "//chrome/app:branded_strings",
      "//chrome/browser/infobars",
      "//chrome/browser/profiles",
      "//chrome/browser/sync",
      "//chrome/browser/ui",
      "//chrome/browser/ui:chrome_pages",
      "//components/infobars/content",
      "//components/prefs",
      "//components/strings",
      "//ui/base",
      "//ui/views",
    ]

    if (enable_request_otr) {
      sources += [ "request_otr_infobar_delegate.cc" ]
      deps += [
        "//brave/components/request_otr/browser",
        "//brave/components/resources:static_resources",
        "//brave/components/resources:strings",
        "//chrome/app:generated_resources",
        "//components/vector_icons",
        "//content/public/browser",
      ]
    }
  }
}
