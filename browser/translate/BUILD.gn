import("//extensions/buildflags/buildflags.gni")

source_set("translate") {
  sources = [
    "brave_translate_prefs_migration.cc",
    "brave_translate_prefs_migration.h",
    "brave_translate_utils.cc",
    "brave_translate_utils.h",
  ]

  deps = [
    "//chrome/browser/profiles:profile",
    "//components/prefs",
    "//components/translate/core/browser",
    "//components/translate/core/common",
    "//extensions/buildflags",
  ]

  # //chrome/browser/profiles:profile privately depends on //extensions/browser
  # on any config where enable_extensions_core is on (e.g. Android), so
  # brave_translate_utils.cc's #include of extensions/browser and
  # extensions/common headers needs a direct dep here too, even though the
  # code they guard is still ENABLE_EXTENSIONS-only (dead on Android for now).
  if (enable_extensions_core) {
    deps += [
      "//extensions/browser",
      "//extensions/common",
    ]
  }
}
