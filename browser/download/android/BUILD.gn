import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

android_library("java") {
  sources = [
    "java/src/org/chromium/chrome/browser/download/BraveMimeUtils.java",
    "java/src/org/chromium/chrome/browser/download/dialogs/BraveDownloadLocationDialogCoordinator.java",
  ]

  deps = [
    ":jni_headers",
    "//base:base_java",
    "//build/android:build_java",
    "//chrome/browser/download/android:file_provider_java",
    "//chrome/browser/download/android:java",
    "//chrome/browser/profiles/android:java",
    "//third_party/jni_zero:jni_zero_java",
    "//ui/android:ui_java",
  ]
}

generate_jni("jni_headers") {
  sources =
      [ "java/src/org/chromium/chrome/browser/download/BraveMimeUtils.java" ]
}

android_library("javatests") {
  testonly = true

  sources = [
    "//chrome/android/javatests/src/org/chromium/chrome/browser/download/DownloadTestHelper.java",
    "//chrome/android/javatests/src/org/chromium/chrome/browser/download/DownloadTestRule.java",
    "javatests/src/org/chromium/chrome/browser/download/BraveDownloadImageMetadataStripperTest.java",
  ]

  deps = [
    "//base:base_java",
    "//base:base_java_test_support",
    "//chrome/android:chrome_java",
    "//chrome/browser/download/android:java",
    "//chrome/browser/flags:java",
    "//chrome/browser/profiles/android:java",
    "//chrome/browser/tab:java",
    "//chrome/test/android:chrome_java_integration_test_support",
    "//chrome/test/android:chrome_java_test_support_common",
    "//chrome/test/android:chrome_java_transit",
    "//components/download/internal/common:internal_java",
    "//components/offline_items_collection/core:core_java",
    "//content/public/test/android:content_java_test_support",
    "//net/android:net_java_test_support",
    "//third_party/androidx:androidx_test_runner_java",
    "//third_party/junit",
    "//ui/android:ui_no_recycler_view_java",
  ]

  # Served by the EmbeddedTestServer and read back from disk by the tests.
  data = [ "//brave/test/data/image_metadata_stripper/" ]
}
