import("//brave/ui/webui/custom_profile_image/buildflags/buildflags.gni")

assert(enable_brave_custom_profile_image_webui)

source_set("image_file") {
  visibility = [ ":unit_tests" ]
  sources = [
    "image_file.cc",
    "image_file.h",
  ]
  public_deps = [
    "//base",
    "//brave/ui/webui/custom_profile_image/buildflags",
    "//skia",
  ]
  deps = [ "//ui/gfx/codec" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "image_file_unittest.cc" ]
  deps = [
    ":image_file",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
