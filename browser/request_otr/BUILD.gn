import("//brave/components/request_otr/common/buildflags/buildflags.gni")

assert(enable_request_otr)

source_set("request_otr") {
  sources = [ "request_otr_service_factory.h" ]
  public_deps = [ "//components/keyed_service/content" ]

  if (!is_android) {
    sources += [ "request_otr_tab_helper.h" ]
    public_deps += [ "//chrome/browser/ui/tabs:tabs_public" ]
  }
}

source_set("impl") {
  visibility = [ "//brave/browser:core" ]

  sources = [ "request_otr_service_factory.cc" ]

  public_deps = [ ":request_otr" ]

  deps = [
    "//base",
    "//brave/browser:browser_process",
    "//brave/components/request_otr/browser",
    "//brave/components/request_otr/common",
    "//chrome/browser/profiles",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
  ]

  if (!is_android) {
    sources += [ "request_otr_tab_helper.cc" ]
    deps += [
      "//brave/browser/infobars:request_otr_infobar_delegate",
      "//components/infobars/content",
      "//components/infobars/core",
      "//content/public/browser",
    ]
  }
}

# The browser tests depend on desktop-only test support.
if (!is_android) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "//brave/browser/request_otr/request_otr_browsertest.cc" ]
    deps = [
      "//base",
      "//brave/browser",
      "//brave/browser/extensions:test_support",
      "//brave/common",
      "//brave/components/brave_component_updater/browser:public",
      "//brave/components/brave_shields/core/browser",
      "//brave/components/brave_shields/core/common",
      "//brave/components/request_otr/browser",
      "//brave/components/request_otr/common",
      "//chrome/browser",
      "//chrome/browser/history",
      "//chrome/browser/ui",
      "//chrome/common",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//components/infobars/content",
      "//components/permissions",
      "//components/prefs",
      "//components/security_interstitials/content:security_interstitial_page",
      "//content/public/browser",
      "//content/test:test_support",
      "//third_party/abseil-cpp:absl",
    ]
  }
}
