import("//brave/components/playlist/core/common/buildflags/buildflags.gni")
import("//build/config/features.gni")

assert(enable_playlist)

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "playlist_media_discovery_browsertests.cc" ]

  deps = []

  if (enable_playlist_webui) {
    sources += [
      "playlist_active_tab_tracker_browsertest.cc",
      "playlist_browsertest.cc",
    ]

    deps += [
      "//brave/app:command_ids",
      "//brave/browser/ui",
      "//brave/browser/ui/sidebar",
      "//chrome/browser/ui:browser_tabstrip",
      "//chrome/browser/ui/actions",
      "//chrome/browser/ui/views/frame:browser_view_header",
      "//chrome/browser/ui/views/frame:toolbar_button_provider",
      "//chrome/browser/ui/views/page_action:page_action_test_support",
    ]
  }

  deps += [
    "//base",
    "//brave/browser/playlist",
    "//brave/components/playlist/content/browser",
    "//brave/components/playlist/content/browser:test_support",
    "//brave/components/playlist/core/common",
    "//chrome/app:command_ids",
    "//chrome/browser",
    "//chrome/browser/profiles:profile",
    "//chrome/test:test_support",
    "//chrome/test/base:chrome_test_utils",
    "//components/network_session_configurator/common",
    "//content/test:test_support",
    "//net",
    "//net:test_support",
  ]

  if (is_android) {
    deps += [ "//chrome/test:test_support_ui_android" ]
  } else {  # !is_android
    deps += [
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/side_panel",
      "//chrome/browser/ui/side_panel:side_panel_views_dependent",
      "//chrome/test:test_support_ui",
    ]
  }

  if (toolkit_views) {
    deps += [ "//brave/browser/ui/views/location_bar" ]
  }
}

source_set("unit_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = []
  deps = []

  # `playlist_data_source_unittest.cc` is desktop only; the remaining Playlist
  # unit tests live in //brave/components/playlist/content/browser.
  if (!is_android) {
    sources += [ "playlist_data_source_unittest.cc" ]
    deps += [
      "//base",
      "//brave/browser/playlist",
      "//brave/browser/playlist:impl",
      "//brave/components/playlist/content/browser",
      "//chrome/browser",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//content/test:test_support",
    ]
  }
}
