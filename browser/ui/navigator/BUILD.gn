import("//brave/components/containers/buildflags/buildflags.gni")

# Linked into the browser binary so BraveAdjustLoadURLParams resolves for the
# call injected into //chrome/browser/ui/navigator:impl.
source_set("chromium_impl") {
  sources = [ "browser_navigator_params_utils.cc" ]

  deps = [
    "//brave/components/containers/buildflags",
    "//chrome/browser/ui/navigator",
    "//content/public/browser",
  ]

  if (enable_containers) {
    deps += [ "//brave/components/containers/content/browser" ]
  }
}
