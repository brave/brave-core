assert(!is_android)

# The interfaces other targets use to talk to Peek.
source_set("public") {
  sources = [
    "public/peek_controller.cc",
    "public/peek_controller.h",
    "public/peek_shields_panel_provider.h",
  ]

  public_deps = [
    "//base",
    "//ui/base/unowned_user_data",
  ]

  deps = [
    "//chrome/browser/ui/browser_window",
    "//content/public/browser",
  ]
}

source_set("peek") {
  sources = [
    "peek_features.cc",
    "peek_features.h",
    "peek_navigation_throttle.cc",
    "peek_navigation_throttle.h",
    "peek_utils.cc",
    "peek_utils.h",
  ]

  public_deps = [
    ":public",
    "//base",
    "//content/public/browser",
    "//url",
  ]

  deps = [
    "//content/public/common",
    "//ui/base",
  ]
}

# Hooks for the chromium_src override of RenderViewContextMenu. Depended on by
# //brave/browser/ui so the hooks are linked into the browser.
source_set("context_menu") {
  sources = [ "peek_context_menu_hooks.cc" ]

  deps = [
    ":peek",
    ":public",
    "//content/public/browser",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "peek_utils_unittest.cc" ]

  deps = [
    ":peek",
    "//content/public/browser",
    "//content/public/common",
    "//testing/gtest",
    "//ui/base",
    "//url",
  ]
}
