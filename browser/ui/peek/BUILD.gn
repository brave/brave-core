assert(!is_android)

source_set("peek") {
  sources = [
    "peek_features.cc",
    "peek_features.h",
    "peek_navigation_throttle.cc",
    "peek_navigation_throttle.h",
    "peek_utils.cc",
    "peek_utils.h",
    "public/peek_controller.cc",
    "public/peek_controller.h",
  ]

  public_deps = [
    "//base",
    "//ui/base/unowned_user_data",
  ]

  deps = [
    "//chrome/browser/ui/browser_window",
    "//components/tabs:public",
    "//content/public/browser",
    "//content/public/common",
    "//net",
    "//ui/base",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "peek_utils_unittest.cc" ]

  deps = [
    ":peek",
    "//content/public/browser",
    "//content/public/common",
    "//testing/gtest",
    "//ui/base",
    "//url",
  ]
}
