import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

assert(is_android)

generate_jni("jni_headers") {
  sources = [ "java/src/org/chromium/chrome/browser/brave_account/BraveAccountDialogOpener.java" ]
}

# Depends on chrome_java (for BraveAccountCustomTabActivity), so it cannot be
# part of it, and is listed in brave_chrome_all_java_deps instead. Java that
# chrome_java calls into - such as BraveAccountDialogMode - has the opposite
# constraint and belongs in //brave/browser/brave_account/android:java.
android_library("java") {
  srcjar_deps = [ "//brave/browser/ui/android/brave_account:jni_headers" ]

  sources = [ "java/src/org/chromium/chrome/browser/brave_account/BraveAccountDialogOpener.java" ]

  deps = [
    "//brave/components/brave_account/mojom:mojom_java",
    "//build/android:build_java",
    "//chrome/android:chrome_java",
    "//content/public/android:content_java",
    "//third_party/jni_zero:jni_zero_java",
    "//ui/android:ui_java",
  ]
}
