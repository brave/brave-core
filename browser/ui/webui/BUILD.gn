import("//brave/browser/updater/buildflags.gni")
import("//brave/build/config.gni")
import("//brave/components/ai_chat/core/common/buildflags/buildflags.gni")
import("//brave/components/brave_wallet/common/buildflags/buildflags.gni")
import("//brave/ui/webui/custom_profile_image/buildflags/buildflags.gni")
import("//ui/webui/webui_features.gni")

source_set("favicon_source_chromium_impl") {
  sources = [ "favicon_source.cc" ]
  deps = [
    "//base",
    "//brave/components/constants",
  ]
}

source_set("brave_webui_source") {
  sources = [
    "brave_webui_source.cc",
    "brave_webui_source.h",
  ]

  public_deps = [ "//base" ]

  deps = [
    "//brave/components/tor/buildflags",
    "//brave/components/webui",
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
    "//services/network/public/mojom",
    "//ui/base:webui_resource_path",
  ]

  if (!is_android) {
    sources += [ "brave_webui_source_desktop.cc" ]
    deps += [
      "//chrome/browser/ui:browser_window_header",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/color:color_headers",
      "//skia",
      "//ui/color",
    ]
  }
}

source_set("brave_sanitized_image_source") {
  sources = [
    "brave_sanitized_image_source.cc",
    "brave_sanitized_image_source.h",
  ]

  public_deps = [
    "//base",
    "//content/public/browser",
    "//services/data_decoder/public/cpp",
    "//url",
  ]

  deps = [
    "//brave/brave_domains",
    "//brave/components/brave_private_cdn",
    "//brave/components/constants",
    "//chrome/browser/profiles:profile",
    "//net",
    "//services/network/public/cpp",
    "//skia",
    "//third_party/blink/public/common",
    "//ui/gfx",
  ]
}

source_set("untrusted_sanitized_image_source") {
  sources = [
    "untrusted_sanitized_image_source.cc",
    "untrusted_sanitized_image_source.h",
  ]

  public_deps = [
    "//chrome/browser/ui/webui/sanitized_image:sanitized_image_source",
    "//content/public/browser",
    "//url",
  ]

  deps = [
    "//base",
    "//brave/components/brave_wallet/common/buildflags",
    "//brave/components/constants",
    "//chrome/common",
  ]

  if (enable_brave_wallet) {
    deps += [ "//brave/components/brave_wallet/common:common_constants" ]
  }
}

source_set("browser_tests") {
  testonly = true

  sources = []

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  deps = [
    "//base",
    "//chrome/browser/profiles",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui/navigator",
    "//chrome/test",
    "//chrome/test:test_support",
    "//components/omnibox/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/base",
  ]

  if (!is_android) {
    sources += [
      "brave_settings_ui_browsertest.cc",
      "searchbox/brave_realbox_handler_browsertest.cc",
      "webui_service_worker_browsertest.cc",
    ]

    deps += [
      "//brave/components/ai_chat/core/common/buildflags",
      "//brave/components/brave_search/common",
      "//chrome/browser/ui/webui/searchbox",
      "//chrome/browser/ui/webui/searchbox:searchbox_test_utils",
      "//chrome/test/base:browser_test_waiters",
      "//content/public/browser",
      "//third_party/blink/public/common",
      "//ui/webui",
      "//ui/webui:test_support",
    ]

    if (enable_ai_chat) {
      deps += [ "//brave/components/ai_chat/core/common" ]
    }
  }

  if (enable_webui_history) {
    sources += [ "history/brave_history_sync_promo_browsertest.cc" ]
    deps += [
      "//base/test:test_support",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/common:constants",
      "//components/sync/base",
    ]
  }

  if (enable_brave_custom_profile_image_webui) {
    deps += [ "//brave/browser/ui/webui/signin:browser_tests" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "brave_sanitized_image_source_unittest.cc",
    "brave_theme_source_unittest.cc",
    "untrusted_sanitized_image_source_unittest.cc",
  ]
  deps = [
    ":brave_sanitized_image_source",
    ":untrusted_sanitized_image_source",
    "//base",
    "//base/test:test_support",
    "//brave/browser/ui",
    "//brave/components/brave_wallet/common/buildflags",
    "//chrome/browser/themes",
    "//chrome/browser/ui/webui:theme_source",
    "//chrome/test:test_support",
    "//chrome/test/base:testing_browser_process",
    "//content/test:test_support",
    "//services/data_decoder/public/cpp:test_support",
    "//services/network:test_support",
    "//testing/gtest",
  ]

  if (enable_sparkle && enable_omaha4) {
    sources += [ "help/brave_version_updater_mac_unittest.mm" ]
    deps += [
      "//brave/browser/updater:features",
      "//chrome/browser/ui/webui/help",
    ]
  }
}
