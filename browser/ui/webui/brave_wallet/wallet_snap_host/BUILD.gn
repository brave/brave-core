import("//brave/components/brave_wallet/common/buildflags/buildflags.gni")

assert(enable_brave_wallet)
assert(enable_snap)

source_set("wallet_snap_host") {
  sources = [
    "wallet_snap_host_ui.cc",
    "wallet_snap_host_ui.h",
  ]
  deps = [
    "//brave/browser/brave_wallet",
    "//brave/components/brave_wallet/browser",
    "//brave/components/brave_wallet/common",
    "//brave/components/brave_wallet/common:mojom",
    "//brave/components/brave_wallet_ui/wallet_snap_host:wallet_snap_host_generated",
    "//brave/components/resources:static_resources_grit",
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
    "//content/public/common",
    "//services/network/public/mojom",
    "//ui/webui",
    "//url",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "wallet_snap_host_browsertest.cc" ]
  deps = [
    ":wallet_snap_host",
    "//base/test:test_support",
    "//brave/browser/brave_wallet",
    "//brave/components/brave_wallet/browser",
    "//brave/components/brave_wallet/common",
    "//brave/components/brave_wallet/common:common_constants",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//testing/gtest",
  ]
}
