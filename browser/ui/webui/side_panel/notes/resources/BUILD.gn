import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "notes"
  static_files = [ "notes.html" ]
  js_files = [ "notes.js" ]
  css_files = [ "notes.css" ]

  ts_composite = true
  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  webui_context_type = "trusted"
  grit_output_dir = "$root_gen_dir/brave"

  mojo_files_deps = [ "//brave/browser/ui/webui:notes_mojom_ts__generator" ]
  mojo_files = [
    "$root_gen_dir/brave/browser/ui/webui/side_panel/notes/notes.mojom-webui.ts",
  ]
  use_brave_grit = true
}
