import("//brave/ui/webui/custom_profile_image/buildflags/buildflags.gni")
import("//build/config/features.gni")

assert(use_blink && !is_android)

source_set("signin") {
  visibility = [ "//brave/browser:core" ]

  sources = [ "profile_customization_ui.cc" ]

  deps = [
    "//base",
    "//brave/app:brave_generated_resources_grit",
    "//brave/ui/webui/custom_profile_image/buildflags",
    "//content/public/browser",
    "//ui/base",
  ]

  if (enable_brave_custom_profile_image_webui) {
    deps += [ "//brave/browser/ui/webui/custom_profile_image" ]
  }
}
