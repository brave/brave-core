assert(!is_android)

source_set("brave_recap") {
  sources = [
    "brave_recap_ui.cc",
    "brave_recap_ui.h",
  ]

  deps = [
    "//base",
    "//brave/browser/brave_stats:first_run_util",
    "//brave/browser/resources/brave_recap:pack_js_resources",
    "//brave/browser/resources/brave_recap:pack_static_resources",
    "//brave/browser/ui:ui_features",
    "//brave/components/brave_perf_predictor/common",
    "//brave/components/brave_recap/common",
    "//brave/components/brave_shields/core/common",
    "//brave/components/resources:strings_grit",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//components/prefs",
    "//content/public/browser",
    "//services/network/public/mojom",
    "//ui/webui",
    "//ui/webui/resources:resources_grit",
  ]
}

source_set("browser_tests") {
  testonly = true

  sources = [ "brave_recap_ui_browsertest.cc" ]

  deps = [
    "//base",
    "//base/test:test_support",
    "//brave/browser/ui:ui_features",
    "//brave/components/brave_perf_predictor/common",
    "//brave/components/brave_shields/core/common",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:incognito_allowed_url",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/prefs",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//url",
  ]

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
}
