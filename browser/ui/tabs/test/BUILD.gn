import("//brave/components/ai_chat/core/common/buildflags/buildflags.gni")
import("//brave/components/psst/buildflags/buildflags.gni")
import("//build/config/ui.gni")

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [
    "brave_tab_strip_model_browsertest.cc",
    "tree_tabs_browsertest.cc",
  ]

  deps = [
    "//brave/browser/ui:brave_tab_prefs",
    "//brave/components/constants",
    "//brave/components/tabs",
    "//chrome/app:command_ids",
    "//chrome/browser",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/tab_group_sync:factories",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/common",
    "//components/prefs",
    "//content/test:test_support",
    "//ui/base",
  ]

  if (!is_android) {
    sources += [
      "brave_tab_features_discard_browsertest.cc",
      "brave_tab_features_discard_browsertest.h",
      "shared_pinned_tab_service_browsertest.cc",
      "shared_pinned_tab_service_browsertest.h",
      "tab_data_browsertest.cc",
    ]
    deps += [
      "//brave/browser/ui",
      "//brave/browser/ui/tabs:tab_strip",
      "//brave/browser/ui/tabs:tabs_public",
      "//brave/components/resources:scaled_resources",
      "//chrome/browser/ui:browser_tabstrip",
      "//chrome/browser/ui:browser_window_header",
      "//chrome/browser/ui:recently_audible_helper",
      "//chrome/browser/ui:ui_features",
      "//chrome/browser/ui/browser_web_contents_delegate",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/tabs",
      "//chrome/browser/ui/tabs:tab_enums",
      "//chrome/browser/ui/tabs:utils",
      "//chrome/browser/ui/toasts",
      "//chrome/browser/ui/views/frame:browser_view_header",
      "//chrome/common",
      "//chrome/test:test_support",
      "//chrome/test/base:in_process_browser_test",
      "//chrome/test/base:interactive_test_utils",
      "//chrome/test/base:platform_browser_test",
      "//chrome/test/base:ui_test_utils",
      "//components/tab_groups",
      "//components/tabs:enum",
      "//net:test_support",
      "//ui/base",
      "//url",
    ]
  }

  # The discard tests use a desktop-only fixture.
  if (!is_android && enable_ai_chat) {
    sources += [ "brave_tab_features_discard_ai_chat_browsertest.cc" ]
    deps += [
      "//brave/browser/ai_chat",
      "//brave/components/ai_chat/core/browser",
      "//brave/components/ai_chat/core/common/mojom",
      "//brave/components/web_mcp/core/browser",
      "//mojo/public/cpp/bindings",
      "//third_party/blink/public/common",
    ]
  }

  if (enable_psst) {
    sources += [ "brave_tab_features_discard_psst_browsertest.cc" ]
    deps += [
      "//brave/browser/psst",
      "//brave/browser/ui/tabs:tabs_public",
      "//brave/browser/ui/views/page_action",
      "//brave/components/psst/core/common",
      "//components/infobars/content",
      "//components/infobars/core",
    ]
  }

  if (is_mac) {
    sources += [ "shared_pinned_tab_service_browsertest_mac.mm" ]
    deps += [ "//chrome/browser/ui/views/frame:browser_native_widget_mac" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = []
  deps = [ "//brave/browser/ui:brave_tab_prefs" ]

  if (!is_android) {
    sources += [
      "tab_style_unittest.cc",
      "tree_tab_node_tab_collection_unittest.cc",
      "vertical_tab_controller_unittest.cc",
    ]
    deps += [
      "//brave/browser/ui/focus_mode",
      "//brave/browser/ui/tabs:tabs_public",
      "//brave/components/tabs",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/browser/ui/tabs:test_support",
      "//chrome/test:test_support",
      "//components/sync_preferences:test_support",
      "//components/tabs:test_support",
      "//content/test:test_support",
      "//testing/gmock",
      "//testing/gtest",
    ]
  }
}

if (use_aura) {
  source_set("interactive_ui_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "tab_cycling_controller_interactive_ui_test.cc" ]

    deps = [
      "//brave/browser/ui/tabs:tabs_public",
      "//chrome/app:command_ids",
      "//chrome/browser",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/ui:browser_commands",
      "//chrome/browser/ui/browser_window",
      "//chrome/common",
      "//chrome/test/base:in_process_browser_test",
      "//chrome/test/base:interactive_test_utils",
      "//components/prefs",
      "//content/test:test_support",
      "//testing/gtest",
      "//ui/aura",
      "//ui/base",
      "//ui/events",
      "//ui/events:test_support",
    ]
  }
}
