import("//brave/components/brave_wayback_machine/buildflags/buildflags.gni")
import("//brave/components/psst/buildflags/buildflags.gni")

if (enable_psst) {
  source_set("psst_infobar") {
    visibility = [
      ":unit_tests",
      "//brave/browser:core",
    ]

    sources = [
      "psst_infobar.cc",
      "psst_infobar.h",
    ]

    public_deps = [ "//brave/browser/ui" ]

    deps = [
      "//base",
      "//brave/app:brave_generated_resources_grit",
      "//brave/browser/psst",
      "//brave/ui/color:nala_color_id",
      "//chrome/browser/ui/color:color_headers",
      "//ui/base",
      "//ui/events",
      "//ui/gfx",
      "//ui/views",
    ]
  }
}

if (enable_brave_wayback_machine) {
  source_set("wayback_machine_infobar") {
    visibility = [
      ":browser_tests",
      ":unit_tests",
      "//brave/browser:core",
    ]

    sources = [
      "wayback_machine_infobar.cc",
      "wayback_machine_infobar.h",
    ]

    public_deps = [
      "//base",
      "//chrome/browser/ui/views/infobars",
      "//ui/base",
    ]

    deps = [
      "//brave/browser/infobars",
      "//brave/components/vector_icons",
      "//brave/ui/color:nala_color_id",
      "//ui/gfx",
      "//ui/views",
    ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "brave_confirm_infobar_unittest.cc",
    "brave_infobar_container_view_unittest.cc",
  ]

  deps = [
    "//base",
    "//brave/browser/ui",
    "//brave/common",
    "//brave/components/infobars/core",
    "//chrome/browser/ui/views:layout_provider",
    "//chrome/test:test_support",
    "//components/infobars/core",
    "//testing/gtest",
    "//ui/base",
    "//ui/events",
    "//ui/gfx",
    "//ui/views",
    "//ui/views:test_support",
  ]

  if (enable_psst) {
    sources += [ "psst_infobar_unittest.cc" ]
    deps += [
      ":psst_infobar",
      "//brave/app:brave_generated_resources_grit",
      "//brave/browser/psst",
      "//brave/components/psst/core/common",
    ]
  }

  if (enable_brave_wayback_machine) {
    sources += [ "wayback_machine_infobar_unittest.cc" ]
    deps += [
      ":wayback_machine_infobar",
      "//base:i18n",
      "//base/test:test_support",
      "//brave/app:brave_generated_resources_grit",
      "//brave/browser/infobars",
      "//brave/components/brave_wayback_machine",
      "//chrome/test/base:chrome_render_view_host_test_harness",
      "//components/infobars/content",
      "//ui/gfx:test_support",
      "//url",
    ]
  }
}

if (enable_brave_wayback_machine) {
  source_set("browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

    sources = [ "wayback_machine_infobar_browsertest.cc" ]

    deps = [
      ":wayback_machine_infobar",
      "//base",
      "//base/test:test_support",
      "//brave/browser/infobars",
      "//brave/components/brave_wayback_machine",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//components/infobars/content",
      "//components/infobars/core",
      "//components/tabs:public",
      "//content/public/browser",
      "//content/test:test_support",
      "//ui/events",
      "//ui/gfx",
      "//ui/gfx:test_support",
      "//ui/views",
      "//ui/views:test_support",
      "//url",
    ]
  }
}
