import("//brave/components/brave_wayback_machine/buildflags/buildflags.gni")

source_set("unit_tests") {
  testonly = true

  sources = [ "brave_confirm_infobar_unittest.cc" ]

  deps = [
    "//base",
    "//brave/browser/ui",
    "//brave/common",
    "//brave/components/infobars/core",
    "//chrome/browser/ui/views:layout_provider",
    "//chrome/test:test_support",
    "//components/infobars/core",
    "//testing/gtest",
    "//ui/base",
    "//ui/events",
    "//ui/gfx",
    "//ui/views",
    "//ui/views:test_support",
  ]

  if (enable_brave_wayback_machine) {
    sources += [ "wayback_machine_infobar_unittest.cc" ]
    deps += [
      "//base:i18n",
      "//base/test:test_support",
      "//brave/app:brave_generated_resources_grit",
      "//brave/browser/infobars",
      "//brave/components/brave_wayback_machine",
      "//chrome/test/base:chrome_render_view_host_test_harness",
      "//components/infobars/content",
      "//ui/gfx:test_support",
      "//url",
    ]
  }
}
