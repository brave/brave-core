import("//brave/components/brave_talk/buildflags/buildflags.gni")

assert(enable_brave_talk)

source_set("brave_talk") {
  sources = [
    "brave_talk_side_panel_navigation_throttle.cc",
    "brave_talk_side_panel_navigation_throttle.h",
    "brave_talk_side_panel_web_view.cc",
    "brave_talk_side_panel_web_view.h",
  ]

  # Header-visible dependencies: `brave_talk_side_panel_web_view.h` derives
  # from `views::WebView`, and
  # `brave_talk_side_panel_navigation_throttle.h` from
  # `content::NavigationThrottle` and `content::WebContentsUserData`.
  public_deps = [
    "//content/public/browser",
    "//ui/views/controls/webview",
  ]

  deps = [
    "//base",
    "//brave/components/sidebar/browser",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/profiles",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/side_panel",
    "//chrome/browser/ui/side_panel:side_panel_views_dependent",
    "//chrome/browser/ui/views/side_panel",
    "//chrome/browser/ui/webui:webui_util",
    "//components/permissions",
    "//components/tabs:public",
    "//ui/base",
    "//url",
  ]
}
