    "//brave/browser/ui/sidebar",
    "//brave/browser/ui/views:view_shadow",
    "//brave/components/containers/buildflags",
    "//brave/components/resources:strings",
    "//brave/components/vector_icons",
    "//brave/ui/color:nala_color_id",
    "//chrome/app:command_ids",
    "//chrome/app:generated_resources",
    "//chrome/browser/favicon",
    "//chrome/browser/history",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/tab_contents",
    "//chrome/browser/ui:browser_commands",
    "//chrome/browser/ui/browser_web_contents_delegate",
