    "//brave/components/vector_icons",
    "//brave/ui/color:nala_color_id",
    "//chrome/app:generated_resources",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ssl",
    "//chrome/browser/tab_contents",
    "//chrome/browser/ui:tab_helpers",
