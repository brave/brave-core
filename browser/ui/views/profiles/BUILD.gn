    "//chrome/browser/ui/views/profiles:avatar_toolbar_button",
    "//chrome/browser/ui/webui/signin:signin_utils",
    "//chrome/common",
    "//chrome/test:test_support",
    "//content/public/browser",
    "//content/public/common",
