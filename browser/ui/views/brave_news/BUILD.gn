import("//brave/components/brave_news/common/buildflags/buildflags.gni")
import("//build/config/ui.gni")

assert(enable_brave_news && toolkit_views)

source_set("brave_news") {
  sources = [
    "brave_news_bubble_controller.cc",
    "brave_news_bubble_controller.h",
    "brave_news_bubble_view.cc",
    "brave_news_bubble_view.h",
