import("//build/config/ozone.gni")

source_set("interactive_ui_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "//brave/browser/ui/views/tabs/dragging/tab_drag_controller_interactive_uitest.cc" ]

  deps = [
    "//brave/browser/ui:brave_tab_prefs",
    "//brave/browser/ui/tabs:tab_strip",
    "//brave/browser/ui/tabs:tabs_public",
    "//brave/components/tabs",
    "//chrome/app:command_ids",
    "//chrome/browser",
    "//chrome/browser/ui",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/tabs:features",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/prefs",
    "//components/tabs:public",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base",
    "//ui/base:ozone_buildflags",
    "//ui/base:test_support",
    "//ui/events:test_support",
    "//ui/views",
  ]

  if (use_ozone) {
    deps += [ "//ui/ozone" ]
  }
}
