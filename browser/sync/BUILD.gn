import("//brave/components/ai_chat/core/common/buildflags/buildflags.gni")

source_set("sync") {
  sources = [
    "brave_sync_service_impl_delegate.cc",
    "brave_sync_service_impl_delegate.h",
  ]

  deps = [
    "//base",
    "//components/history/core/browser",
    "//components/sync/service",
    "//components/sync_device_info",
  ]
}

if (!is_ios) {
  # Implements the hook that the chromium_src override of
  # //chrome/browser/sync's sync_service_factory.cc forward declares.
  source_set("chromium_impl") {
    sources = [ "brave_sync_controllers.cc" ]

    deps = [
      "//brave/components/ai_chat/core/common/buildflags",
      "//chrome/browser/profiles:profile",
      "//components/sync/service",
    ]

    if (enable_ai_chat) {
      deps += [
        "//base",
        "//brave/browser/ai_chat",
        "//brave/components/ai_chat/core/browser",
        "//brave/components/ai_chat/core/common",
      ]
    }
  }

  source_set("browser_tests") {
    testonly = true
    sources = [
      "brave_sync_smoke_browsertest.cc",
      "network_time_helper_browsertest.cc",
    ]

    deps = [
      "//base",
      "//base/test:test_support",
      "//brave/components/brave_sync:network_time_helper",
      "//brave/components/brave_sync:prefs",
      "//brave/components/brave_sync/test:test_support",
      "//chrome/browser",
      "//chrome/browser/sync",
      "//chrome/test:test_support",
      "//chrome/test/base:chrome_test_utils",
      "//components/sync:test_support",
      "//components/sync/base",
      "//components/sync/protocol",
      "//components/sync/service",
      "//net:test_support",
    ]

    if (enable_ai_chat) {
      sources += [ "ai_chat_sync_browsertest.cc" ]
      deps += [
        "//brave/components/ai_chat/core/common",
        "//chrome/browser/autofill",
        "//components/autofill/core/browser",
        "//components/prefs",
      ]
    }

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  }
}
