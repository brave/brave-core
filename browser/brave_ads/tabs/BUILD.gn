import("//brave/components/brave_ads/buildflags/buildflags.gni")

assert(enable_brave_ads)

source_set("tabs") {
  sources = [
    "ads_tab_helper.cc",
    "ads_tab_helper.h",
    "credit_card_field_focus_observer.cc",
    "credit_card_field_focus_observer.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/tabs:tabs_public",
    "//components/sessions:session_id",
    "//content/public/browser",
    "//ui/base/unowned_user_data",
  ]

  deps = [
    "//brave/browser/brave_ads",
    "//brave/components/brave_ads/browser",
    "//brave/components/brave_ads/content/browser",
    "//brave/components/brave_ads/content/common/mojom",
    "//brave/components/brave_ads/core/mojom",
    "//brave/components/brave_ads/core/public:headers",
    "//brave/components/brave_rewards/core",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/translate",
    "//chrome/browser/ui/browser_window",
    "//chrome/common",
    "//components/autofill/content/browser",
    "//components/autofill/core/browser",
    "//components/prefs",
    "//components/sessions",
    "//components/tabs:public",
    "//components/translate/core/browser",
    "//ui/base",
  ]
}

source_set("browser_tests") {
  testonly = true

  if (!is_android) {
    sources = [
      "ads_tab_helper_browsertest.cc",
      "credit_card_field_focus_observer_browsertest.cc",
    ]

    deps = [
      ":tabs",
      "//brave/browser/brave_ads",
      "//brave/components/brave_ads/core/browser/service:test_support",
      "//brave/components/brave_ads/core/public:headers",
      "//brave/components/brave_rewards/core",
      "//chrome/browser/profiles/keep_alive",
      "//chrome/browser/ui:browser_tabstrip",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
      "//components/tabs:public",
      "//net:test_support",
    ]

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  }
}
