# The rules of docs/best-practices/coding-standards-apis.md. See
# docs/knowledge_base/README.md for the fields.
agentic_review {
  # Any C++ change: custom helpers, and uses of possibly deprecated APIs.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    rules: "docs/knowledge_base/rules/cxx_apis/reuse-existing-utilities.md"
    rules: "docs/knowledge_base/rules/cxx_apis/no-new-uses-of-deprecated-apis.md"
  }
  # The deprecated callback types and Bind().
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bbase::(?:Callback|Closure|Bind)\\b"
    rules: "docs/knowledge_base/rules/cxx_apis/no-deprecated-callback-types.md"
  }
  # Once callbacks, and callbacks run without std::move.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bOnce(?:Callback|Closure)\\b"
    content_patterns: "\\b\\w*(?:[Cc]allback|cb|[Cc]losure)_?\\.Run\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/move-once-callbacks.md"
  }
  # The C time API.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bstd::(?:time|ctime|localtime|gmtime|mktime|difftime|strftime|tm)\\b"
    content_patterns: "\\btime_t\\b"
    content_patterns: "\\bstruct\\s+tm\\b"
    content_patterns: "#\\s*include\\s*<(?:ctime|time\\.h)>"
    content_patterns: "(?:^|[^\\w.>:])(?:time|localtime|gmtime|mktime|ctime)\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/base-time-over-c-time.md"
  }
  # Key-by-key reads of a dictionary.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "(?:\\.|->)Find(?:String|Int|Bool|Double|Dict|List)(?:Key|ByDottedPath)?\\s*\\("
    content_patterns: "\\bJSONValueConverter\\b"
    rules: "docs/knowledge_base/rules/cxx_apis/json-value-converter-over-manual-parsing.md"
  }
  # The banned standard unordered containers.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bstd::unordered_(?:map|set|multimap|multiset)\\b"
    content_patterns: "#\\s*include\\s*<unordered_(?:map|set)>"
    rules: "docs/knowledge_base/rules/cxx_apis/no-std-unordered-containers.md"
  }
  # The banned Abseil B-tree containers.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\babsl::btree_(?:map|set|multimap|multiset)\\b"
    content_patterns: "absl/container/btree_"
    rules: "docs/knowledge_base/rules/cxx_apis/no-absl-btree-containers.md"
  }
  # Declarations of maps and sets.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\b(?:std::(?:map|set|multimap|multiset)|base::flat_(?:map|set)|absl::flat_hash_(?:map|set))\\s*<"
    rules: "docs/knowledge_base/rules/cxx_apis/choose-associative-container-by-use.md"
  }
  # Node hash containers, and flat hash maps of unique_ptr values.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\babsl::node_hash_(?:map|set)\\b"
    content_patterns: "\\babsl::flat_hash_map\\s*<.*\\bstd::unique_ptr\\s*<"
    rules: "docs/knowledge_base/rules/cxx_apis/hash-map-pointer-stability.md"
  }
  # The deprecated base::Value GetAs*() methods.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bGetAs(?:String|Integer|Int|Boolean|Bool|Double|List|Dictionary|Dict)\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/no-value-get-as-methods.md"
  }
  # base::Value accessors that CHECK the type.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "(?:\\.|->)Get(?:Bool|Int|Double|String|Dict|List|Blob)\\s*\\(\\s*\\)"
    rules: "docs/knowledge_base/rules/cxx_apis/value-get-if-accessors-for-unchecked-types.md"
  }
  # std::to_string().
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bstd::to_w?string\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/number-to-string-over-std-to-string.md"
  }
  # C-style casts, other than to void.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    ast_patterns: "{kind: cast_expression, not: {has: {field: type, regex: '^void$'}}}"
    rules: "docs/knowledge_base/rules/cxx_apis/no-c-style-casts.md"
  }
  # Clone() calls, and callbacks run with arguments.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\.Clone\\s*\\(\\s*\\)"
    content_patterns: "\\.Run\\s*\\(\\s*[^)\\s]"
    rules: "docs/knowledge_base/rules/cxx_apis/move-instead-of-copying-values.md"
  }
  # Definitions of plural-named structs and classes.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    path_expression: "(?:.*/)?[^/]*\\.mojom"
    content_patterns: "^\\s*(?:struct|class)\\s+(?:\\w+(?:\\([^)]*\\))?\\s+)?[A-Z]\\w*s(?:\\s+final)?\\s*(?:\\{|:|$)"
    rules: "docs/knowledge_base/rules/cxx_apis/no-plural-wrapper-types.md"
  }
  # JSON written to, or read from, string prefs.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bJSONWriter::Write\\w*\\s*\\("
    content_patterns: "\\bJSONReader::Read\\w*\\s*\\([^;]*GetString\\s*\\("
    content_patterns: "(?:\\.|->)SetString\\s*\\([^;]*(?:json|JSON)"
    rules: "docs/knowledge_base/rules/cxx_apis/pref-dict-and-list-values-not-json-strings.md"
  }
  # String constants defined as macros.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "^\\s*#\\s*define\\s+\\w+\\s+(?:u8|u|U|L)?\""
    rules: "docs/knowledge_base/rules/cxx_apis/const-char-arrays-over-string-defines.md"
  }
  # String parameters and comparisons that name a type, kind, mode or state.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\b(?:const\\s+std::string\\s*&|std::string_view)\\s*\\w*(?:type|kind|mode|state|status|level|category)\\s*(?:[,)]|$)"
    content_patterns: "\\b\\w*(?:type|kind|mode|state|status)\\w*\\s*[!=]=\\s*\""
    rules: "docs/knowledge_base/rules/cxx_apis/enums-over-string-constants.md"
  }
  # C++ code that throws or catches exceptions.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bthrow\\b"
    content_patterns: "\\btry\\s*\\{"
    content_patterns: "\\bcatch\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/no-cxx-exceptions-in-third-party-code.md"
  }
  # GN targets that change the exceptions configs.
  capability_groups {
    path_expression: "(?:.*/)?BUILD\\.gn|(?:.*/)?[^/]*\\.gni"
    content_patterns: "//build/config/compiler:(?:no_)?exceptions\\b"
    content_patterns: "-fexceptions\\b"
    rules: "docs/knowledge_base/rules/cxx_apis/no-cxx-exceptions-in-third-party-code.md"
  }
  # Hand-written erase loops and the erase-remove idiom.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "=\\s*\\S*(?:\\.|->)erase\\s*\\(\\s*\\w+\\s*\\)"
    content_patterns: "(?:\\.|->)erase\\s*\\(\\s*(?:std::)?(?:ranges::)?remove_if\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/erase-if-over-manual-erase-loops.md"
  }
  # Parameters taking a const std::vector reference.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "(?:^|[(,])\\s*const\\s+std::vector<.*>\\s*&\\s*\\w+\\s*(?:[,)]|$)"
    rules: "docs/knowledge_base/rules/cxx_apis/span-params-over-const-vector-refs.md"
  }
  # Vectors constructed with a size or other arguments.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bstd::vector<[^;=]*>\\s+\\w+\\s*\\(\\s*[^)\\s]"
    content_patterns: "=\\s*std::vector<[^;]*>\\s*\\(\\s*[^)\\s]"
    rules: "docs/knowledge_base/rules/cxx_apis/fixed-array-for-runtime-sized-arrays.md"
  }
  # Byte vectors.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bstd::vector<\\s*(?:unsigned\\s+char|uint8_t|std::byte)\\s*>"
    rules: "docs/knowledge_base/rules/cxx_apis/heap-array-for-byte-buffers.md"
  }
  # Manual copies of a range into a vector.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bstd::back_inserter\\s*\\("
    content_patterns: "(?:\\.|->)reserve\\s*\\("
    content_patterns: "\\bstd::(?:ranges::)?copy(?:_n|_if)?\\s*\\("
    content_patterns: "\\bstd::vector<[^;]*>\\s*\\w*\\s*\\(\\s*[\\w.()>-]+(?:\\.|->)c?begin\\s*\\(\\s*\\)"
    rules: "docs/knowledge_base/rules/cxx_apis/to-vector-for-range-conversions.md"
  }
  # Linked lists.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bstd::(?:list|forward_list)\\s*<"
    content_patterns: "#\\s*include\\s*<(?:list|forward_list)>"
    rules: "docs/knowledge_base/rules/cxx_apis/contiguous-containers-over-std-list.md"
  }
  # Sentinel returns, comparisons and comments.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\breturn\\s+-1\\s*;"
    content_patterns: "\\breturn\\s+(?:\"\"|std::string\\(\\)|std::string_view\\(\\))\\s*;"
    content_patterns: "[!=]=\\s*-1\\b"
    content_patterns: "=\\s*-1\\s*;"
    content_patterns: "(?:\"\"|-1)\\s+means\\b"
    content_patterns: "\\bmeans\\s+\"?(?:unset|none|no value|not set|missing)\\b"
    rules: "docs/knowledge_base/rules/cxx_apis/optional-over-sentinel-values.md"
  }
  # Members assigned a freshly constructed value.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\b\\w+_\\s*=\\s*(?:\\w+::)+[A-Z]\\w*(?:<[^;]*>)?\\s*[({]"
    content_patterns: "\\b\\w+_\\s*=\\s*[A-Z]\\w*(?:<[^;]*>)?\\s*(?:\\(\\s*\\)|\\{\\s*\\})\\s*;"
    content_patterns: "=\\s*std::make_optional\\b"
    rules: "docs/knowledge_base/rules/cxx_apis/emplace-to-engage-optional-members.md"
  }
  # Functions returning bool with an out parameter.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bbool\\s+(?:\\w+::)*[A-Z]\\w*\\s*\\(.*\\*\\s*(?:out\\w*|\\w*_out|result|output)\\s*(?:[,)]|$)"
    content_patterns: "^\\s*[\\w:<>, ]+\\*\\s*(?:out\\w*|\\w*_out)\\s*[,)]"
    rules: "docs/knowledge_base/rules/cxx_apis/optional-over-bool-and-out-param.md"
  }
  # Constants declared const.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "^\\s*(?:static\\s+)?const\\s+[^=;(]*\\bk[A-Z]\\w*(?:\\[\\w*\\])?\\s*="
    rules: "docs/knowledge_base/rules/cxx_apis/constexpr-for-compile-time-constants.md"
  }
  # Constants in an anonymous namespace at file scope.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|mm)"
    path_expression_exclusion: "chromium_src/.*"
    ast_patterns: "{kind: declaration, regex: '^(?:static\\s+)?(?:constexpr|const)\\b', inside: {kind: declaration_list, inside: {kind: namespace_definition, not: {has: {kind: namespace_identifier}}, inside: {kind: translation_unit}}}}"
    rules: "docs/knowledge_base/rules/cxx_apis/constants-inside-component-namespace.md"
  }
  # String literals ending in an escaped newline.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\\\n\"\\s*[),;]*\\s*$"
    rules: "docs/knowledge_base/rules/cxx_apis/raw-string-literals-for-multiline-strings.md"
  }
  # Primitive types and pointers taken by const reference.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bconst\\s+(?:unsigned\\s+)?(?:int|bool|float|double|char|char16_t|size_t|ptrdiff_t|u?int(?:8|16|32|64)_t|long|short)\\s*&"
    content_patterns: "\\bconst\\s+[\\w:]+\\s*\\*\\s*(?:const\\s*)?&"
    content_patterns: "[\\w:>]\\s*\\*\\s*const\\s*&"
    rules: "docs/knowledge_base/rules/cxx_apis/primitives-by-value-not-const-ref.md"
  }
  # DISALLOW_COPY_AND_ASSIGN.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bDISALLOW_COPY_AND_ASSIGN\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/no-disallow-copy-and-assign.md"
  }
  # Move constructors and move assignments declared without noexcept.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\b[A-Z]\\w*\\s*\\(\\s*[A-Z]\\w*\\s*&&\\s*\\w*\\s*\\)\\s*(?:=\\s*default|;|\\{|:)"
    content_patterns: "\\boperator=\\s*\\(\\s*[A-Z]\\w*\\s*&&\\s*\\w*\\s*\\)\\s*(?:=\\s*default|;|\\{|:)"
    rules: "docs/knowledge_base/rules/cxx_apis/noexcept-move-operations.md"
  }
  # Parameters taking a std::optional by reference.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "(?:^|[(,])\\s*(?:const\\s+)?std::optional<.*>\\s*&\\s*\\w+\\s*(?:[,)]|$)"
    rules: "docs/knowledge_base/rules/cxx_apis/no-optional-reference-params.md"
  }
  # Functions taking a URL in shields, debounce and content settings code.
  capability_groups {
    path_expression: "(?:.*/)?(?:brave_shields|debounce|content_settings)/(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    path_expression_exclusion: "(?:.*/)?[^/]*(?:_unittest|_browsertest|_test|_interactive_uitest)\\.(?:cc|mm)"
    content_patterns: "\\bGURL\\s*&?\\s*\\w+\\s*(?:[,)]|$)"
    rules: "docs/knowledge_base/rules/cxx_apis/early-return-for-non-http-urls.md"
  }
  # Setters taking a narrow numeric parameter.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\b(?:set_\\w+|Set[A-Z]\\w*)\\s*\\(\\s*(?:u?int(?:8|16|32)_t|int|unsigned(?:\\s+int)?|short|long|float|double)\\s+\\w+\\s*\\)"
    rules: "docs/knowledge_base/rules/cxx_apis/no-narrowing-in-setter-params.md"
  }
  # Removed pref registrations.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    diff_patterns: "^-.*\\bRegister\\w*Pref\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/deprecate-prefs-before-removing.md"
  }
  # Test-only signals in production code.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    path_expression_exclusion: "(?:.*/)?[^/]*(?:_unittest|_browsertest|_test|_interactive_uitest|_test_util|_test_utils|_test_support|_test_helper|_test_helpers|_mock|_fake)\\.(?:cc|h|mm)"
    path_expression_exclusion: "(?:.*/)?(?:test|tests|testing)/.*"
    content_patterns: "\\bCHECK_IS_TEST\\s*\\("
    content_patterns: "#\\s*if(?:def)?\\s*(?:defined\\s*\\(\\s*)?UNIT_TEST\\b"
    content_patterns: "\\b\\w+_for_testing\\b"
    content_patterns: "\\b\\w+ForTesting\\b"
    content_patterns: "//.*\\b(?:for|in|by|during)\\s+(?:unit\\s+|browser\\s+)?tests?\\b"
    content_patterns: "\\bis_test(?:ing)?\\b"
    content_patterns: "\\bIsTest\\w*\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/no-test-only-code-in-production.md"
  }
  # A hard-coded scheme separator.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\"://\""
    rules: "docs/knowledge_base/rules/cxx_apis/standard-scheme-separator-constant.md"
  }
  # Empty lambdas.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\[[^\\]]*\\]\\s*\\([^()]*\\)\\s*(?:mutable\\s*)?(?:->\\s*[\\w:<>]+\\s*)?\\{\\s*\\}"
    rules: "docs/knowledge_base/rules/cxx_apis/do-nothing-for-no-op-callbacks.md"
  }
  # StrCat() appended with +=.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\+=\\s*(?:base::)?StrCat\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/str-append-over-plus-equals-str-cat.md"
  }
  # Reverse iterators.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "(?:\\.|->)c?r(?:begin|end)\\s*\\(\\s*\\)"
    content_patterns: "\\bstd::(?:ranges::)?c?r(?:begin|end)\\s*\\("
    content_patterns: "\\bstd::(?:make_)?reverse_iterator\\b"
    content_patterns: "\\bbase::Reversed\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/views-reverse-over-reverse-iterators.md"
  }
  # Reverse traversals of any kind.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "(?:\\.|->)c?r(?:begin|end)\\s*\\(\\s*\\)"
    content_patterns: "\\bstd::(?:ranges::)?c?r(?:begin|end)\\s*\\("
    content_patterns: "\\bstd::(?:make_)?reverse_iterator\\b"
    content_patterns: "\\bbase::Reversed\\s*\\("
    content_patterns: "\\bstd::(?:ranges::)?views::reverse\\s*\\("
    content_patterns: "\\bstd::ranges::reverse_view\\b"
    content_patterns: "\\bfor\\s*\\([^;]*;[^;]*;\\s*(?:--\\s*\\w+|\\w+\\s*--)\\s*\\)"
    rules: "docs/knowledge_base/rules/cxx_apis/comment-why-reverse-order.md"
  }
  # StringPrintf().
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\b(?:base::)?StringPrintf\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/str-format-over-string-printf.md"
  }
  # Integer static_casts and base/numerics casts.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bstatic_cast<\\s*(?:u?int(?:8|16|32|64)_t|size_t|ptrdiff_t|int|unsigned(?:\\s+int)?|long(?:\\s+long)?|short)\\s*>"
    content_patterns: "\\bbase::(?:saturated|checked|strict)_cast\\s*<"
    rules: "docs/knowledge_base/rules/cxx_apis/saturated-or-checked-cast-for-integer-conversions.md"
  }
  # Casts of arithmetic, size arithmetic, and checked math.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "_cast<[^>]+>\\s*\\([^;]*\\w\\s*[-+*]\\s*\\w"
    content_patterns: "\\bCheckedNumeric<"
    content_patterns: "\\bMakeCheckedNum\\s*\\("
    content_patterns: "\\b(?:WithSize|Uninit|resize|reserve|malloc|calloc|realloc)\\s*\\([^;]*\\w\\s*[*+]\\s*\\w"
    content_patterns: "\\b(?:size_t|u?int(?:32|64)_t)\\s+\\w+\\s*=\\s*\\w+\\s*\\*\\s*\\w+"
    rules: "docs/knowledge_base/rules/cxx_apis/checked-arithmetic-before-casting.md"
  }
  # CheckedNumeric arithmetic.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bCheckedNumeric<"
    content_patterns: "\\bMakeCheckedNum\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/checked-math-non-member-helpers.md"
  }
  # Loops that break or return a bool from inside.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    ast_patterns: "{any: [{kind: for_range_loop}, {kind: for_statement}], has: {stopBy: end, any: [{kind: break_statement}, {pattern: 'return true;'}, {pattern: 'return false;'}]}}"
    rules: "docs/knowledge_base/rules/cxx_apis/ranges-algorithms-over-search-loops.md"
  }
  # substr() calls.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "(?:\\.|->)substr\\s*\\("
    rules: "docs/knowledge_base/rules/cxx_apis/substr-only-when-over-limit.md"
  }
  # Error out parameters.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\*\\s*\\w*err(?:or)?\\w*\\s*(?:[,)]|$)"
    rules: "docs/knowledge_base/rules/cxx_apis/expected-over-optional-and-error-out-param.md"
  }
  # Constant maps and sets built at runtime, and switch cases returning literals.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm)"
    content_patterns: "\\bconst\\s+(?:std::(?:map|set|unordered_map|unordered_set)|base::flat_(?:map|set))\\s*<"
    content_patterns: "\\bstatic\\s+(?:const\\s+)?(?:std::(?:map|set)|base::flat_(?:map|set))\\s*<"
    content_patterns: "\\bbase::NoDestructor<\\s*(?:const\\s+)?(?:std::(?:map|set)|base::flat_(?:map|set)|absl::flat_hash_(?:map|set))"
