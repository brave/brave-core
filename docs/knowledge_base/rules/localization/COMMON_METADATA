  # Removed uses of string resources, in code.
  capability_groups {
    path_expression: "(?:.*/)?[^/]*\\.(?:cc|h|mm|java|kt|swift|ts|tsx|py)"
    diff_patterns: "^-.*\\bIDS_[A-Z0-9_]+\\b"
    diff_patterns: "^-.*\\bR\\.string\\.\\w+"
    rules: "docs/knowledge_base/rules/localization/grd-no-unused-strings.md"
