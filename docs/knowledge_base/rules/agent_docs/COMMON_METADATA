# Instructions for agents: Brave's skills, prompts and commands, and the skills
# its CI agents follow with the documents they read. The code health trackers
# are run records, not instructions.
agentic_review {
  capability_groups {
    path_expression: "(?:agents|\\.claude)/.*\\.md"
    path_expression: "tools/cr/(?:autolift|codehealth)/.*\\.md"
    path_expression: "tools/cr/commit_messages\\.md"
    path_expression_exclusion: "tools/cr/codehealth/M[0-9]+\\.md"
    rules: "docs/knowledge_base/rules/agent_docs/state-instructions-without-anecdotes.md"
  }
}
