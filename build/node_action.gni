import("//brave/build/node_bin.gni")

# Runs a Node.js script as a GN action during the build. Use ONLY for build
# steps that require Node.js (e.g. webpack, typescript, etc.). In other cases
# use standard action() + python script.
#
# The script is executed with the Chromium-bundled //third_party/node binary.
#
# Scripts should live under //brave/build. This directory follows the erasable
# TypeScript syntax and is type-checked as Node.js code (no web-specific types
# or features) for direct Node.js execution.
#
# Usage example:
#
#     import("//brave/build/node_action.gni")
#
#     node_action("generate_tsconfig") {
#       script = "//brave/build/commands/scripts/genTsConfig.js"
#       args = [ "--root-gen-dir=" + rebase_path(root_gen_dir) ]
#       deps = [ ":build_flags_json" ]
#       outputs = [ "$root_gen_dir/tsconfig-webpack.json" ]
#     }
template("node_action") {
  assert(defined(invoker.script), "node_action requires script")
  _node_script = invoker.script
  _deps_hook = "//brave/build/commands/lib/depsHook.ts"

  action(target_name) {
    script = "//brave/build/gn_run_rsp.py"
    args = [ "{{response_file_name}}" ]

    inputs = [
      node_bin,
      _deps_hook,
      _node_script,
    ]
    if (defined(invoker.inputs)) {
      inputs += invoker.inputs
    }

    if (defined(invoker.depfile)) {
      depfile = invoker.depfile
    } else {
      depfile = "$target_gen_dir/$target_name.d"
    }

    _stamp_file = "$target_gen_dir/$target_name.stamp"

    outputs = [ _stamp_file ]
    if (defined(invoker.outputs)) {
      outputs += invoker.outputs
    }

    # Chromium's Node.js version check.
    deps = [ "//third_party/node:check_version" ]
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }

    forward_variables_from(invoker,
                           [
                             "data",
                             "data_deps",
                             "public_deps",
                             "testonly",
                             "visibility",
                           ])

    response_file_contents = [
      "DEPS_HOOK_ROOT_BUILD_DIR=" + rebase_path(root_build_dir),
      "DEPS_HOOK_DEP_FILE=" + rebase_path(depfile, root_build_dir),
      "DEPS_HOOK_STAMP_FILE=" + rebase_path(_stamp_file, root_build_dir),
    ]
    if (defined(invoker.depfile)) {
      response_file_contents += [ "DEPS_HOOK_APPEND_DEPS=1" ]
    }

    # Use absolute path for deps hook import to avoid issues on cwd changes
    # inside the script.
    if (host_os == "win") {
      deps_hook_import_file_url = "file:///" + rebase_path(_deps_hook)
    } else {
      deps_hook_import_file_url = "file://" + rebase_path(_deps_hook)
    }

    response_file_contents += [
      rebase_path(node_bin, root_build_dir),
      "--import=" + deps_hook_import_file_url,
      rebase_path(_node_script, root_build_dir),
    ]

    if (defined(invoker.args)) {
      response_file_contents += invoker.args
    }
  }
}
