import("//build/toolchain/gcc_toolchain.gni")

# Target toolchains for musl libc (see `use_musl`).
template("brave_musl_clang_toolchain") {
  clang_toolchain(target_name) {
    enable_linker_map = true
    toolchain_args = {
      current_cpu = invoker.cpu
      current_os = "linux"
      is_musl = true
    }
  }
}

brave_musl_clang_toolchain("clang_x64_musl") {
  cpu = "x64"
}

brave_musl_clang_toolchain("clang_arm64_musl") {
  cpu = "arm64"
}
