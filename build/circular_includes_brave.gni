# Brave counterpart to Chromium's `allow_circular_includes_from_untriaged`
# (//build/circular_includes_untriaged.gni): existing Brave targets that set
# `allow_circular_includes_from` and predate Chromium's allowlist enforcement
# in //.gn (04bc701821ed, crbug.com/556482973).
allow_circular_includes_from_brave = [
  # //brave/browser:core's allow_circular_includes_from pulls in
  # //brave/browser/tor:impl, which depends back on
  # //brave/browser:browser_process.
  "//brave/browser:core",

  # brave_prefs_util_impl depends back on //brave/browser/extensions:extensions.
  "//brave/browser/extensions:extensions",

  # brave_ui_allow_circular_includes_from lists sub-targets (e.g.
  # //brave/browser/ui/brave_origin) that depend back on
  # //brave/browser/ui:ui.
  "//brave/browser/ui:ui",
]
