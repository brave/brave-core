# Upstream `//v8` demoted its dependency on `:v8_snapshot` (and therefore
# `:run_mksnapshot_default`) from public_deps to deps, so targets that bundle
# snapshot_blob.bin via `//v8` alone (i.e. not through
# //tools/v8_context_snapshot) no longer see run_mksnapshot_default as a
# dependency. Restore that edge explicitly.
brave_v8_run_mksnapshot_default_deps = [ "//v8:run_mksnapshot_default" ]
