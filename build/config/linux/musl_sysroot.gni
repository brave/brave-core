assert(is_musl)

if (current_cpu == "x64") {
  _arch = "x86_64"
} else if (current_cpu == "arm64") {
  _arch = "aarch64"
} else {
  assert(false, "No musl sysroot for cpu: $current_cpu")
}

brave_musl_sysroot = "$musl_sysroot_dir/alpine_edge_$_arch"
