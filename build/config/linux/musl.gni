declare_args() {
  # Build target binaries against musl libc instead of glibc. Selects a musl
  # target toolchain (//brave/build/toolchain/linux); other toolchains reset
  # this to false, so host tools are still built against glibc and run on the
  # build machine. Create the sysroot with
  # //brave/build/linux/musl/create_sysroot.sh.
  #
  # musl deliberately has no preprocessor macro; C/C++ can check LIBC_MUSL.
  is_musl = false

  # Directory containing musl sysroots made by create_sysroot.sh.
  musl_sysroot_dir = "//brave/build/linux/musl/sysroots"
}
