{
  "extends": "../../tsconfig",
  "include": [
    "../../components/definitions/*",
    "../../components/**/storybook",
    "../../components/**/stories/*.tsx",
    "../../components/**/*.stories.tsx",
  ],
  "compilerOptions": {
    "allowJs": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "outDir": "../../out/storybook_dist",
    // Generated copy lives under out/.../gen; default @types discovery would
    // not find brave/node_modules/@types.
    "typeRoots": ["../../node_modules/@types", "../../components/definitions"],
  },
}
