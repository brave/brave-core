# Brave counterpart to Chromium's `check_includes_strict_exceptions` directory
# allowlist, until Brave's targets meet the strict include checks.
brave_check_includes_strict_exceptions = [
  # TODO(https://github.com/brave/brave-browser/issues/59200): Fix Brave's
  # targets' strict include violations and remove this entry.
  {
    includer = "//brave/*"
  },

  # `prepopulated_engines` builds Brave's `brave_prepopulated_engines.h`, whose
  # `//base` use `json_to_struct` can't make a public dep.
  {
    includer = "//third_party/search_engines_data/*"
  },
]
