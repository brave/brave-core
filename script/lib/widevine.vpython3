# Provides `cryptography` (and its build deps) for
# third_party/widevine/scripts/signature_generator.py, which is invoked via
# `vpython3 -vpython-spec` since that script lives outside our source tree.

python_version: "3.11"

# The default set of platforms vpython checks does not yet include mac-arm64,
# and widevine signing runs on mac.
verify_pep425_tag: [
    {python: "cp311", abi: "cp311", platform: "macosx_10_10_intel"},
    {python: "cp311", abi: "cp311", platform: "macosx_11_0_arm64"}
]

wheel: <
  name: "infra/python/wheels/cryptography/${vpython_platform}"
  version: "version:43.0.0"
>
wheel: <
  name: "infra/python/wheels/cffi/${vpython_platform}"
  version: "version:1.15.1.chromium.2"
>
wheel: <
  name: "infra/python/wheels/pycparser-py2_py3"
  version: "version:2.19"
>
