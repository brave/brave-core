+#if defined(LIBC_MUSL)
+// musl's pthread_kill() uses tkill, which V8's CPU profiler needs. It's only
+// safe to allow when the renderer has its own PID namespace (the user-NS
+// sandbox, not setuid), so tkill can only reach the renderer's own threads.
+bool OwnsPidNamespace() {
+  const int required = SandboxLinux::kUserNS | SandboxLinux::kPIDNS;
+  return getpid() == 1 &&
+         (SandboxLinux::GetInstance()->GetStatus() & required) == required;
+}
+#endif  // defined(LIBC_MUSL)
+
 }  // namespace
