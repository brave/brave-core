     _forceUpdate = YES;
   }
 }
 
 - (void)setProgress:(float)progress {
   DCHECK_CURRENTLY_ON(BrowserThread::UI);
-  DockTileView* dockTileView =
-      base::apple::ObjCCast<DockTileView>(NSApp.dockTile.contentView);
 
-  dockTileView.progress = progress;
+  _progress = progress;
 }
 
 @end
