+    });
+
+    test('AllowsLeftAndRightMouseDownOnBookmark', () => {
+      const item = getCrUrlListItemElementWithId('3');
+      assertTrue(!!item);
+
+      for (const button of [0, 2]) {
+        const event = new MouseEvent('mousedown', {
+          button,
+          bubbles: true,
+          composed: true,
+          cancelable: true,
+        });
+
+        item.dispatchEvent(event);
+
+        assertFalse(event.defaultPrevented);
+      }
+    });
