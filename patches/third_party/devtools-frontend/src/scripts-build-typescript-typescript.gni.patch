   assert(defined(invoker.sources),
          "You must specify 'sources' for $target_name")
 
@@ -498,6 +498,31 @@ template("ts_library") {
   }
 }
 
+template("ts_library") {
+  assert(defined(invoker.sources),
+         "You must specify 'sources' for $target_name")
+
+  ts_library_chromium(target_name) {
+    forward_variables_from(invoker, "*")
+
+    # Brave adds new DevTools files from //brave/..., which sit outside this
+    # target's rootDir. run_with_restat.py hardlinks them next to the upstream
+    # sources before tsc runs, so everything tsc is told about them -- the
+    # tsconfig `files` list, the -dts source list and the computed output paths
+    # -- has to name that in-tree copy instead. `_all_sources` keeps the
+    # original path, so the actions still list the real file as an input. See
+    # //brave/docs/devtools_frontend_patching.md.
+    sources = []
+    foreach(src, invoker.sources) {
+      if (label_matches(src, [ "//brave/*" ])) {
+        sources += [ get_path_info(src, "file") ]
+      } else {
+        sources += [ src ]
+      }
+    }
+  }
+}
+
 set_defaults("ts_library") {
