+void HistoryBackend::CloseHistoryDatabaseAfterLowDiskError() {
+  TRACE_EVENT0("browser",
+               "HistoryBackend::CloseHistoryDatabaseAfterLowDiskError");
+  scheduled_kill_db_ = false;
+  saw_sqlite_full_error_ = false;
+  if (!db_) {
+    return;
+  }
+
+  // Notify the sync bridge about storage error. It'll report failures to the
+  // sync engine and stop accepting remote updates, matching KillHistoryDatabase()
+  // behavior without deleting committed local history.
+  if (history_sync_bridge_) {
+    history_sync_bridge_->OnDatabaseError();
+  }
+
+  // Roll back the long-running transaction. Attempting to commit here can hit
+  // the same full-disk failure again. The important property is preserving the
+  // already-committed History file so SQLite can recover it on a later restart.
+  singleton_transaction_.reset();
+
+  // The expirer keeps tabs on the active databases. Tell it about the databases
+  // which will be closed.
+  expirer_.SetDatabases(nullptr, nullptr);
+
+  CloseAllDatabases();
+}
