diff --git a/build/config/compiler_cpu_abi.gn b/build/config/compiler_cpu_abi.gn
index ae62bab587e7dd1727cc44550d9fad42a23cf3ce..58ff9e20aa1b8f38160e38f6b3d34d48c60c8b7e 100644
--- a/build/config/compiler_cpu_abi.gn
+++ b/build/config/compiler_cpu_abi.gn
@@ -364,3 +364,14 @@ if ((is_posix && !is_apple) || is_fuchsia) {
     cpu_abi_ldflags += [ "-m64" ]
   }
 }
+
+# Brave: musl target triple. Clang uses the last --target, overriding the above.
+if (is_musl) {
+  assert(current_cpu == "x64" || current_cpu == "arm64")
+  _musl_arch = "x86_64"
+  if (current_cpu == "arm64") {
+    _musl_arch = "aarch64"
+  }
+  cpu_abi_cflags += [ "--target=${_musl_arch}-unknown-linux-musl" ]
+  cpu_abi_ldflags += [ "--target=${_musl_arch}-unknown-linux-musl" ]
+}
