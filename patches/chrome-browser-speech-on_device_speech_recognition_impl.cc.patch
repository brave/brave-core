diff --git a/chrome/browser/speech/on_device_speech_recognition_impl.cc b/chrome/browser/speech/on_device_speech_recognition_impl.cc
index e03a15d411477699fc5c40505aaf04dd0ba11692..b29b28e4987bb8bad5c78f382ce34b14a1c023e1 100644
--- a/chrome/browser/speech/on_device_speech_recognition_impl.cc
+++ b/chrome/browser/speech/on_device_speech_recognition_impl.cc
@@ -158,6 +158,9 @@ void OnDeviceSpeechRecognitionImpl::Available(
     const std::vector<std::string>& languages,
     media::mojom::SpeechRecognitionQuality quality,
     OnDeviceSpeechRecognitionImpl::AvailableCallback callback) {
+  if (quality == media::mojom::SpeechRecognitionQuality::kDictation) {
+    quality = media::mojom::SpeechRecognitionQuality::kCommand;
+  }
 #if BUILDFLAG(IS_ANDROID)
   std::move(callback).Run(media::mojom::AvailabilityStatus::kUnavailable);
 #else
@@ -246,6 +249,18 @@ void OnDeviceSpeechRecognitionImpl::Install(
     const std::vector<std::string>& languages,
     media::mojom::SpeechRecognitionQuality quality,
     OnDeviceSpeechRecognitionImpl::InstallCallback callback) {
+  if (quality == media::mojom::SpeechRecognitionQuality::kDictation) {
+    quality = media::mojom::SpeechRecognitionQuality::kCommand;
+  }
+  if (CanRenderFrameHostUseOnDeviceSpeechRecognition() &&
+      ShouldRequestBraveOnDeviceSpeechModelConsent(languages, quality)) {
+    RequestBraveOnDeviceSpeechModelConsent(
+        render_frame_host(),
+        base::BindOnce(&OnDeviceSpeechRecognitionImpl::Install,
+                       weak_ptr_factory_.GetWeakPtr(), languages, quality),
+        std::move(callback));
+    return;
+  }
 #if BUILDFLAG(IS_ANDROID)
   std::move(callback).Run(false);
 #else
