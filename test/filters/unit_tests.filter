# These tests are related to MV2 extension deprecation, which is disabled until
# MV2 extensions are removed from the Web Store.
-ManifestV2ExperimentManagerDisableWithReEnableAndPolicyUnitTest.*
-ExtensionInstallStatusTestWithMV2Deprecation.*
-ManifestV2ExperimentManagerUnsupportedUnitTest.*
-MV2DeprecationImpactCheckerUnitTest.*
-ManifestV2ExperimentManagerDisableWithReEnableUnitTest.*
-MV2DeprecationImpactCheckerUnitTestWithAllowlist.*

# These tests crash because we make ~BrowserActions() virtual (see
# chrome-browser-ui-browser_actions.h.patch) so BraveBrowserActions can be
# deleted through a BrowserActions*. The added vtable pointer shifts
# BrowserActions::root_action_item_ off offset 0, but the test fakes the
# BrowserActions layout with a plain (vtable-less) struct FakeBrowserActions and
# reinterpret_casts it. root_action_item() then reads past the fake struct and
# returns a garbage pointer, which ActionManager::FindAction dereferences and
# crashes. The reinterpret_cast hack in the upstream test is incompatible with
# our layout and the test can't be fixed without patching upstream.
-ContextualTasksUtilsTest.*

# These tests fail because we allow MV2 extensions.
-ExtensionInstallStatusTest.UnsupportedManifestVersion
-ManifestV2HandlerUnitTest.MV2ExtensionsCannotBeEnabled
-ManifestV2HandlerUnitTest.ProfileMetrics_ExtensionLocationsAreProperlyGrouped
-ManifestV2HandlerUnitTest.ProfileMetrics_ExtensionsThatAreDisabledForOtherReasonsEmitOther
-ManifestV2HandlerUnitTest.ShouldBlockInstallation_UserInstalledExtensions

# These tests assume kSensorsAllowAskBlockPermissionModel's upstream default
# (disabled), under which the sensors content setting icon stays hidden while
# access is simply allowed. Brave ships this feature enabled by default, so
# the icon is shown, which these tests don't expect.
-ContentSettingImageModelTest.SensorAccessPermissionsChanged
-ContentSettingImageModelTest.SensorAccessed

# These tests fail because we block motion sensors by default
# (brave/brave-browser#4789), so the default SENSORS setting is never ALLOW or
# ASK.
-HostContentSettingsMapTest.SensorsAskByDefault
-HostContentSettingsMapTest.SensorsAskByDefaultRequiresAllowAskBlockPermissionModel
-HostContentSettingsMapTest.SensorsDefaultSettingIsAllow

# This test crashes because we disable blink::features::kFencedFrames.
# AppendFencedFrame() still constructs a fenced frame via test-only APIs, but
# with the feature off, ContentSubresourceFilterWebContentsHelper's throttle
# manager never gets created for it, so navigating the frame hits
# CHECK(rfh) in GetThrottleManager().
-StorageAccessAPITabHelperTest.OnFrameReceivedUserActivation_FencedFrame

# These tests fail because we disable blink::features::kFencedFrames.
-ActorOneTimeTokenFillingServiceImplTest.ValidateFormFillingContext_FencedFrame_InsecureContext
-SaasUsageNavigationObserverTest.DoNotReportFencedFrameNavigation

# These tests fail because we disable `net::features::kTLSTrustAnchorIDs`.
-SSLConfigServiceManagerTest.PrefsPreservedAfterTrustAnchorIDsUpdated
-SSLConfigServiceManagerTest.TrustAnchorIDsAfterPrefChange

# These tests fail because we stub out the metrics in LogProfileAvatar as it
# calls NOTREACHED() if it encounters an unknown icon index.
-ProfileManagerTest.ProfileAvatarRecordedAtProfileInit
-ProfileMetricsTest.LogProfileAvatar

# This test fails because we suppress kLinkCopied toast.
-ToastControllerUnitTest.RecordToastDismissReasonHistogram

# Thit test fails because we override MenuConfig so the expected values don't
# match.
-ActionAppMenuTest.HeaderAndMenuItemBorderLayout

# These tests fail because they expect Chrome's app menu search placeholder,
# which reads "Search Brave features and actions" with Brave's strings.
-ActionAppMenuWithSearchTest.SearchBarEnabledWithFeatureFlag
-AppMenuSearchBarViewTest.InitialProperties

# This test fails because Brave's page actions, added by the plasters in
# rewrite/chrome/browser/ui/page_action/action_ids.h.yaml and
# page_action_properties_provider.cc.yaml, have no PageActionType variant in
# upstream's page/histograms.xml.
-PageActionPropertiesProviderTest.HistogramNamesMatchVariants

# These tests expect a LoadingPredictor, which never exists now that
# IsLoadingPredictorEnabled() always returns false.
-All/NoStatePrefetchFallbackToPreconnectTest.LinkRelPrerender/*
-LcpCriticalPathPredictorPageLoadMetricsObserverTest.*
-LoadingPredictorConfigTest.PrefDisabled
-LoadingPredictorConfigTest.PrefEnabled
-NetworkHintsHandlerImplTest.*
-RenderViewContextMenuPrefsTest.LensImageSearchIssuesGoogleLensPreconnect
-RenderViewContextMenuPrefsTest.LensRegionSearchIssuesGoogleLensPreconnect

# Lens is disabled
-RenderViewContextMenuPrefsTest.GlicShareImageEligibility

# As we reset VerticalTabs preference when it's not enabled via flags,
# this test fails
-TabMetricsProviderTest.LogsSessionStartMetrics

# These tests check the checked state of upstream's IDC_BOOKMARK_BAR_SUBMENU_*
# items (Always Show/Hide, Only on NTP), but
# BraveBookmarkContextMenuController::AddBraveBookmarksSubmenu() removes that
# submenu and its items, replacing them with our own bookmark bar visibility
# submenu (IDC_BRAVE_BOOKMARK_BAR_*), so the items no longer exist to be found.
# Equivalent coverage exists in
# brave_bookmark_context_menu_controller_unittest.cc.
-All/BookmarkContextMenuUpdateSubMenuStateTest.UpdateSubMenuState/*

# These tests fail because they hardcode "Incognito" in the expected window
# title whereas we use "Private"
-ActionAppMenuManagerTest.BlockActionsIncognitoNewTabTextOverride

# Brave's RenderViewContextMenu::InitMenu() classifies the selection with an
# AutocompleteClassifier, whose SearchProvider DCHECKs on the TemplateURLService
# this harness doesn't create.
-ChromeWebContentsViewDelegateViewsClipboardTest.*

# These tests expect search suggestions on by default, but we default
# prefs::kSearchSuggestEnabled to false, so no suggest request is sent.
-All/SearchProviderDebouncingTest.*/*

# These tests fail because they expect "Google Password Manager" to appear in
# the subtitle, but instead "Brave Password Manager" appears there
-RemoteActorCredentialSharingActorBrandingTest.PlumbsActorBrandingAndAgentParameters/GeminiDefault
-RemoteActorCredentialSharingImplTest.SearchOriginPlumbsSearchBrandingAndAgentParameters
-RemoteActorSelectionDialogControllerTest.Properties*
-RemoteActorSelectionDialogControllerTest.SetActorNameAndLearnMoreUrlOverrideDefaults

# This test fails because we default omnibox::kAIModeSettings to -1 (AI Mode
# disallowed), and it asserts the upstream default.
-RemoteActorCredentialSharingActorBrandingTest.PlumbsActorBrandingAndAgentParameters/SearchDefault
-RemoteActorCredentialSharingActorBrandingTest.PlumbsActorBrandingAndAgentParameters/SearchWithFinchJsonOverrides
-RemoteActorCredentialSharingImplTest.SearchManagedProfileWithSparkDisabled_AllowedWhenAimAllowed
-RemoteActorCredentialSharingPolicyMatrixTest.EnforcesEnterprisePolicy/SearchManagedProfileWithSparkDisabled_AllowedWhenAimAllowed

# These tests fail because of mismatch in location bar height (32 vs 34)
-OmniboxPopupUITest.FullWebUIOmniboxLayoutHelperStandardMode
-OmniboxPopupUITest.FullWebUIOmniboxLayoutHelperTouchUiMode

# Brave stubs IsLiveCaptionFeatureSupported() to false, so LiveCaptionController
# never registers a caption bubble listener. The first translated dispatch
# returns false, setting stop_transcriptions_, and later results are dropped.
-LiveCaptionSpeechRecognitionHostTest.MultiSentencePartialDebouncedWhenTrailingSentenceUnpunctuated

# This test fails because we disable kSegmentationPlatformFeature
-SegmentationPlatformServiceFactoryTest.TestTipsNotificationsRanker

# This test fails because Brave's GCM driver doesn't start until the user
# enables GCM, so the InstanceID it expects to reload was never stored.
-ExtensionGCMAppHandlerTest.RemoveInstanceIDOnExtensionUnload

# This test crashes because Brave's private window avatar uses
# kIncognitoOldIcon, which the WebUI toolbar's IconTable doesn't map. See
# chromium_src/chrome/browser/ui/views/profiles/avatar_toolbar_button_state_manager.cc.
# Brave doesn't enable the WebUI avatar button (kWebUIAvatarButton).
-WebUIAvatarToolbarButtonTest.GetWidthAndPreferredSizeChanged

