import("//build/config/android/rules.gni")

# Kept out of chrome_java so that targets chrome_java depends on, such as
# //brave/browser/quick_search_engines/android:java, can read the Day Zero
# variant without a dependency cycle.
android_library("java") {
  sources = [ "DayZeroHelper.java" ]
  deps = [
    "//base:base_java",
    "//build/android:build_java",
    "//chrome/browser/preferences:java",
    "//third_party/jni_zero:jni_zero_java",
  ]
}
