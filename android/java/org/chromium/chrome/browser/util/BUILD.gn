import("//build/config/android/rules.gni")

# Only the sources of this package that depend on nothing inside chrome_java
# live here; the rest stay in brave_java_sources.gni.
android_library("java") {
  sources = [ "BraveProfileUtils.java" ]

  deps = [
    "//base:base_java",
    "//build/android:build_java",
    "//chrome/browser/profiles/android:java",
  ]
}

robolectric_library("junit") {
  testonly = true
  sources = [ "BraveProfileUtilsTest.java" ]

  deps = [
    ":java",
    "//base:base_java",
    "//base:base_junit_test_support",
    "//chrome/browser/profiles/android:java",
    "//third_party/junit",
    "//third_party/mockito:mockito_java",
  ]
}
