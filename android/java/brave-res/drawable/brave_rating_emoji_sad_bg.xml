<!-- Leading pill of the emoji pair: wide outer (leading) corners, tight inner
     corners where it meets the happy pill. `corners` radii are absolute, so
     drawable-ldrtl/ carries the mirrored variant. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/systemfeedback_error_background" />
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="8dp"
        android:bottomRightRadius="8dp"
        android:bottomLeftRadius="20dp" />
</shape>
