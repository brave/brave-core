<!-- Trailing pill of the emoji pair: tight inner corners where it meets the sad
     pill, wide outer (trailing) corners. `corners` radii are absolute, so
     drawable-ldrtl/ carries the mirrored variant. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/systemfeedback_success_background" />
    <corners
        android:topLeftRadius="8dp"
        android:topRightRadius="20dp"
        android:bottomRightRadius="20dp"
        android:bottomLeftRadius="8dp" />
</shape>
