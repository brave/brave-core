<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/top_sites_tooltip_layout"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/brave_top_sites_tooltip_background">

    <TextView
        style="@style/DefaultRegular"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:text="@string/brave_ntp_top_sites_tooltip_desc"
        android:textColor="@color/text_primary"/>

    <ImageButton
        android:id="@+id/top_sites_tooltip_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top"
        android:background="@null"
        android:padding="0dp"
        app:tint="@color/icon_default"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/close"/>

</LinearLayout>
