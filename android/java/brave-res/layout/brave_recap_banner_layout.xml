<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ntp_recap_banner_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_dark_bg_alpha"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="0dp"
    android:paddingBottom="16dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/brave_recap_badge" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recap_banner_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/ntp_recap_banner_title"
            android:textColor="@color/primitive_neutral_100"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/recap_banner_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/primitive_neutral_100"
            android:textSize="14sp" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/recap_banner_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:layout_marginTop="-16dp"
        android:alpha="0.7"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:padding="16dp"
        app:srcCompat="@drawable/ic_close"
        app:tint="@color/primitive_neutral_100" />

</LinearLayout>
