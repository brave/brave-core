<?xml version='1.0' encoding='UTF-8'?>
<grit-part>
  <message name="IDS_BRAVE_HISTORY_EMBEDDINGS_HEADING" desc="On brave://history, the heading for semantic history search results showing the best matches for a search query.">
    Best matches for "<ph name="SEARCH_QUERY"><ex>pizza</ex>$1</ph>"
  </message>
  <message name="IDS_BRAVE_HISTORY_EMBEDDINGS_HEADING_LOADING" desc="On brave://history, the heading for semantic history search results while they load.">
    Searching for "<ph name="SEARCH_QUERY"><ex>pizza</ex>$1</ph>"
  </message>
  <message name="IDS_BRAVE_HISTORY_EMBEDDINGS_FOOTER" desc="On brave://history, the footer text below the semantic history search results.">
    This is an experimental feature and won’t always get it right.
  </message>
  <message name="IDS_BRAVE_HISTORY_EMBEDDINGS_MATCH_RESULT" desc="On brave://history, announced by the screen reader when semantic history search finds a single result.">
    best match
  </message>
  <message name="IDS_BRAVE_HISTORY_EMBEDDINGS_MATCH_RESULTS" desc="On brave://history, announced by the screen reader when semantic history search finds several results.">
    best matches
  </message>
</grit-part>
