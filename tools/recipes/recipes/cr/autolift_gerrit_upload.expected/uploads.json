[
  {
    "cmd": [
      "git",
      "rev-parse",
      "--abbrev-ref",
      "HEAD"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "find branch"
  },
  {
    "cmd": [
      "brockit",
      "show",
      "--from-ref-hash=@previous-major"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "find branch start"
  },
  {
    "cmd": [
      "brockit",
      "show",
      "--gerrit-ccs=160"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "find ccs"
  },
  {
    "cmd": [
      "git",
      "clone",
      "--depth",
      "1",
      "https://chromium.googlesource.com/chromium/tools/depot_tools",
      "[WORKSPACE]/b/src/third_party/depot_tools"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "clone depot_tools"
  },
  {
    "cmd": [
      "gclient"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "verify gclient"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "RECIPE[cr/autolift_gerrit_upload].resources/gerrit_upload.py",
      "--url",
      "ssh://autolift-bot@gerrit-ssh.brave.com:29418/brave-browser/brave-core",
      "--branch",
      "cr160",
      "--start",
      "ffffffffffffffffffffffffffffffffffffffff",
      "--head",
      "origin/cr160",
      "--cc",
      "cdesouza",
      "--cc",
      "erogul",
      "--cc",
      "alexey",
      "--json-output",
      "/path/to/tmp/json"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "upload",
    "output_properties": {
      "review": {}
    }
  },
  {
    "name": "$result",
    "summaryMarkdown": "Nothing to review."
  }
]
