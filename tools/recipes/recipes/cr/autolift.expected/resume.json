[
  {
    "cmd": [
      "vpython3",
      "tools/cr/autolift/autolift.py",
      "advise",
      "159",
      "--resume",
      "--json-output",
      "/path/to/tmp/json"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "advise"
  },
  {
    "cmd": [
      "git",
      "clone",
      "--depth",
      "1",
      "https://chromium.googlesource.com/chromium/tools/depot_tools",
      "[WORKSPACE]/b/src/third_party/depot_tools"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "clone depot_tools"
  },
  {
    "cmd": [
      "gclient"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "verify gclient"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "RECIPE_MODULE[claude_cli]/resources/run_claude.py",
      "--log",
      "[WORKSPACE]/b/src/brave/.autolift/cr159/claude.jsonl",
      "--logs",
      "[WORKSPACE]/b/src/brave/.autolift/cr159",
      "--must-read",
      "[WORKSPACE]/b/src/brave/tools/cr/autolift/SKILL.md",
      "--report",
      "[WORKSPACE]/b/src/brave/.autolift/cr159/report.md",
      "--",
      "claude",
      "--print",
      "Resume cr159.",
      "--permission-mode",
      "auto",
      "--output-format",
      "stream-json",
      "--verbose",
      "--add-dir",
      "[WORKSPACE]/b",
      "--add-dir",
      "[WORKSPACE]/rc/tmp",
      "--allowedTools",
      "Edit(/[WORKSPACE]/b/**)",
      "Write(/[WORKSPACE]/b/**)",
      "Bash(vpython3 tools/cr/autolift/autolift.py publish *)",
      "Bash(vpython3 .autolift/tooling/cr/autolift/autolift.py publish *)",
      "Bash(echo *)",
      "Edit(/[WORKSPACE]/rc/tmp/**)",
      "Write(/[WORKSPACE]/rc/tmp/**)"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1",
      "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
      "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "0",
      "CLAUDE_CODE_TMPDIR": "[WORKSPACE]/rc/tmp"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "autolift"
  },
  {
    "cmd": [
      "cat",
      "[WORKSPACE]/b/src/brave/.autolift/cr159/report.md"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "report"
  },
  {
    "name": "$result"
  }
]
