[
  {
    "cmd": [
      "git",
      "ls-remote",
      "--heads",
      "https://github.com/brave/brave-core.git",
      "refs/heads/cr*"
    ],
    "name": "find latest cr branch"
  },
  {
    "cmd": [
      "git",
      "clone",
      "--depth",
      "1",
      "https://chromium.googlesource.com/chromium/tools/depot_tools",
      "[WORKSPACE]/b/src/third_party/depot_tools"
    ],
    "name": "clone depot_tools"
  },
  {
    "cmd": [
      "gclient"
    ],
    "name": "verify gclient"
  },
  {
    "cmd": [
      "git",
      "cache",
      "exists",
      "--quiet",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git"
    ],
    "name": "git cache populate exists (before)"
  },
  {
    "cmd": [
      "git",
      "cache",
      "populate",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git",
      "--reset-fetch-config",
      "--no-fetch-tags"
    ],
    "name": "git cache populate"
  },
  {
    "cmd": [
      "git",
      "cache",
      "exists",
      "--quiet",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git"
    ],
    "name": "git cache populate exists (after)"
  },
  {
    "cmd": [
      "git",
      "cache",
      "exists",
      "--quiet",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git"
    ],
    "name": "git cache exists"
  },
  {
    "cmd": [
      "git",
      "clone",
      "--no-checkout",
      "--local",
      "--shared",
      "/b/cache/github.com-brave-brave-core",
      "[WORKSPACE]/b/src/brave"
    ],
    "name": "brave-core clone from git cache"
  },
  {
    "cmd": [
      "git",
      "config",
      "gc.auto",
      "0"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core disable auto-gc: gc.auto=0"
  },
  {
    "cmd": [
      "git",
      "config",
      "gc.autodetach",
      "0"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core disable auto-gc: gc.autodetach=0"
  },
  {
    "cmd": [
      "git",
      "config",
      "gc.autopacklimit",
      "0"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core disable auto-gc: gc.autopacklimit=0"
  },
  {
    "cmd": [
      "git",
      "config",
      "maintenance.gc.enabled",
      "false"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core disable auto-gc: maintenance.gc.enabled=false"
  },
  {
    "cmd": [
      "git",
      "config",
      "maintenance.auto",
      "false"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core disable auto-gc: maintenance.auto=false"
  },
  {
    "cmd": [
      "git",
      "checkout",
      "--force",
      "origin/cr158",
      "--"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core checkout ref"
  },
  {
    "cmd": [
      "git",
      "remote",
      "set-url",
      "--push",
      "origin",
      "https://github.com/brave/brave-core.git"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core restore origin push url"
  },
  {
    "cmd": [
      "git",
      "checkout",
      "--force",
      "-B",
      "cr158"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core checkout branch"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "use_remoteexec=false\n",
      "[WORKSPACE]/b/src/brave/.env"
    ],
    "name": "write .env"
  },
  {
    "cmd": [
      "git",
      "cr",
      "install-hook"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "install commit-msg hook"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "rmtree",
      "[WORKSPACE]/b/src/brave/.autolift/cr158"
    ],
    "name": "clear earlier run"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "rmtree",
      "[WORKSPACE]/b/src/out"
    ],
    "name": "clear out dir"
  },
  {
    "cmd": [
      "git",
      "fetch",
      "origin",
      "cr159"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "fetch newest cr branch"
  },
  {
    "cmd": [
      "git",
      "show",
      "origin/cr159:tools/cr/autolift/sync_tooling.py"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "read sync script"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure_directory",
      "[WORKSPACE]/b/src/brave/.autolift/cr158",
      "--mode",
      "0o777"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "create run dir"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "",
      "[WORKSPACE]/b/src/brave/.autolift/cr158/sync_tooling.py"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "write sync script"
  },
  {
    "cmd": [
      "python3",
      "[WORKSPACE]/b/src/brave/.autolift/cr158/sync_tooling.py",
      "--repo",
      "[WORKSPACE]/b/src/brave",
      "--milestone",
      "158"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "sync tooling"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "RECIPE_MODULE[claude_cli]/resources/run_claude.py",
      "--log",
      "[WORKSPACE]/b/src/brave/.autolift/cr158/claude.jsonl",
      "--logs",
      "[WORKSPACE]/b/src/brave/.autolift/cr158",
      "--",
      "claude",
      "--print",
      "Fix what fails in the CI of cr158's pull request by following the \"Autofix run\" section of tools/cr/autolift/SKILL.md. Read the whole file before starting. The milestone N is 158.\n\nThis is an unattended CI run: there is no human to ask, so make the calls the document describes and record them in the report.",
      "--permission-mode",
      "auto",
      "--output-format",
      "stream-json",
      "--verbose",
      "--add-dir",
      "[WORKSPACE]/b",
      "--allowedTools",
      "Edit(/[WORKSPACE]/b/**)",
      "Write(/[WORKSPACE]/b/**)"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1",
      "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
      "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "0"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "autolift"
  },
  {
    "cmd": [
      "cat",
      "[WORKSPACE]/b/src/brave/.autolift/cr158/report.md"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "report"
  },
  {
    "name": "$result"
  }
]
