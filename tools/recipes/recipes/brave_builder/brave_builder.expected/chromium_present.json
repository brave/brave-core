[
  {
    "cmd": [
      "git",
      "clone",
      "--depth",
      "1",
      "https://chromium.googlesource.com/chromium/tools/depot_tools",
      "[WORKSPACE]/b/src/third_party/depot_tools"
    ],
    "name": "clone depot_tools"
  },
  {
    "cmd": [
      "gclient"
    ],
    "name": "verify gclient"
  },
  {
    "cmd": [
      "git",
      "cache",
      "exists",
      "--quiet",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git"
    ],
    "name": "git cache populate exists (before)"
  },
  {
    "cmd": [
      "git",
      "cache",
      "populate",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git",
      "--reset-fetch-config",
      "--no-fetch-tags"
    ],
    "name": "git cache populate"
  },
  {
    "cmd": [
      "git",
      "cache",
      "exists",
      "--quiet",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git"
    ],
    "name": "git cache populate exists (after)"
  },
  {
    "cmd": [
      "git",
      "cache",
      "exists",
      "--quiet",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git"
    ],
    "name": "git cache exists"
  },
  {
    "cmd": [
      "git",
      "clone",
      "--no-checkout",
      "--local",
      "--shared",
      "/b/cache/github.com-brave-brave-core",
      "[WORKSPACE]/b/src/brave"
    ],
    "name": "brave-core clone from git cache"
  },
  {
    "cmd": [
      "git",
      "config",
      "gc.auto",
      "0"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "disable auto-gc: gc.auto=0"
  },
  {
    "cmd": [
      "git",
      "config",
      "gc.autodetach",
      "0"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "disable auto-gc: gc.autodetach=0"
  },
  {
    "cmd": [
      "git",
      "config",
      "gc.autopacklimit",
      "0"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "disable auto-gc: gc.autopacklimit=0"
  },
  {
    "cmd": [
      "git",
      "config",
      "maintenance.gc.enabled",
      "false"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "disable auto-gc: maintenance.gc.enabled=false"
  },
  {
    "cmd": [
      "git",
      "checkout",
      "--force",
      "origin/master",
      "--"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core checkout ref"
  },
  {
    "cmd": [
      "git",
      "remote",
      "set-url",
      "--push",
      "origin",
      "https://github.com/brave/brave-core.git"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core restore origin push url"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "use_remoteexec=false\n",
      "[WORKSPACE]/b/src/brave/.env"
    ],
    "name": "write .env"
  },
  {
    "cmd": [
      "pnpm",
      "run",
      "build",
      "--target=brave:all"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "build"
  },
  {
    "cmd": [
      "pnpm",
      "run",
      "test",
      "brave_all_unit_tests",
      "--output_xml",
      "--test-launcher-bot-mode",
      "--test-launcher-jobs=8"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "test brave_all_unit_tests"
  },
  {
    "cmd": [
      "pnpm",
      "run",
      "test",
      "brave_browser_tests",
      "--output_xml",
      "--test-launcher-bot-mode",
      "--test-launcher-jobs=8"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "test brave_browser_tests"
  },
  {
    "cmd": [
      "pnpm",
      "run",
      "test",
      "brave_interactive_ui_tests",
      "--output_xml",
      "--test-launcher-bot-mode",
      "--test-launcher-jobs=8"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "test brave_interactive_ui_tests"
  },
  {
    "cmd": [
      "pnpm",
      "run",
      "test",
      "brave_network_tests",
      "--output_xml",
      "--test-launcher-bot-mode",
      "--test-launcher-jobs=8"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "test brave_network_tests"
  },
  {
    "name": "$result"
  }
]
