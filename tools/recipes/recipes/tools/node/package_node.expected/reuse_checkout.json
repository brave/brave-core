[
  {
    "cmd": [
      "git",
      "fetch",
      "--depth",
      "2",
      "origin",
      "refs/heads/master"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "fetch brave-core ref"
  },
  {
    "cmd": [
      "git",
      "checkout",
      "--force",
      "FETCH_HEAD"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "checkout brave-core ref"
  },
  {
    "cmd": [
      "git",
      "sparse-checkout",
      "list"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "sparse-checkout list"
  },
  {
    "cmd": [
      "git",
      "sparse-checkout",
      "add",
      "third_party/node",
      "tools/cr"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "sparse-checkout add"
  },
  {
    "cmd": [
      "git",
      "clone",
      "--depth",
      "1",
      "https://chromium.googlesource.com/chromium/tools/depot_tools",
      "[WORKSPACE]/b/src/third_party/depot_tools"
    ],
    "name": "clone depot_tools"
  },
  {
    "cmd": [
      "gclient"
    ],
    "name": "verify gclient"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "[WORKSPACE]/b/src/brave/third_party/node/download_node.py",
      "--clear"
    ],
    "name": "download node"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "[WORKSPACE]/b/src/brave/third_party/node/package_node.py",
      "--output-dir",
      "[WORKSPACE]/out",
      "--upload"
    ],
    "name": "package node"
  },
  {
    "name": "$result"
  }
]
