[
  {
    "cmd": [
      "git",
      "clone",
      "--depth",
      "1",
      "https://chromium.googlesource.com/chromium/tools/depot_tools",
      "[WORKSPACE]/b/src/third_party/depot_tools"
    ],
    "name": "clone depot_tools"
  },
  {
    "cmd": [
      "gclient"
    ],
    "name": "verify gclient"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "RECIPE_MODULE[claude_cli]/resources/run_claude.py",
      "--log",
      "[WORKSPACE]/rc/claude/claude.jsonl",
      "--logs",
      "[WORKSPACE]/rc/claude",
      "--",
      "claude",
      "--print",
      "Fix the build.\n\nThe checkout is in `src`.",
      "--permission-mode",
      "auto",
      "--output-format",
      "stream-json",
      "--verbose",
      "--add-dir",
      "[WORKSPACE]/b/src",
      "--add-dir",
      "[WORKSPACE]/rc/tmp",
      "--allowedTools",
      "Edit(/[WORKSPACE]/b/src/**)",
      "Write(/[WORKSPACE]/b/src/**)",
      "Edit(/[WORKSPACE]/rc/tmp/**)",
      "Write(/[WORKSPACE]/rc/tmp/**)"
    ],
    "env": {
      "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
      "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "0",
      "CLAUDE_CODE_TMPDIR": "[WORKSPACE]/rc/tmp"
    },
    "name": "claude"
  },
  {
    "name": "$result"
  }
]
