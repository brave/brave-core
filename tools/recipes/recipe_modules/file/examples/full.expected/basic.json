[
  {
    "cmd": [
      "git",
      "clone",
      "--depth",
      "1",
      "https://chromium.googlesource.com/chromium/tools/depot_tools",
      "[WORKSPACE]/b/src/third_party/depot_tools"
    ],
    "name": "clone depot_tools"
  },
  {
    "cmd": [
      "gclient"
    ],
    "name": "verify gclient"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "/etc/greeting",
      "/path/to/tmp/"
    ],
    "name": "read greeting"
  },
  {
    "cmd": [
      "echo",
      "hello\n"
    ],
    "name": "echo"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "/etc/greeting",
      "/path/to/tmp/"
    ],
    "name": "read raw greeting"
  },
  {
    "cmd": [
      "echo",
      "hello bytes"
    ],
    "name": "echo raw"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "/etc/config.json",
      "/path/to/tmp/"
    ],
    "name": "read config"
  },
  {
    "cmd": [
      "echo",
      "{'key': 'value'}"
    ],
    "name": "echo config"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "/etc/greeting.json",
      "/path/to/tmp/json"
    ],
    "name": "read proto greeting"
  },
  {
    "cmd": [
      "echo",
      "hello proto"
    ],
    "name": "echo proto"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "/etc/empty.json",
      "/path/to/tmp/json"
    ],
    "name": "read empty proto"
  },
  {
    "cmd": [
      "echo",
      "''"
    ],
    "name": "echo empty proto"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "hello again\n",
      "/tmp/greeting"
    ],
    "name": "write greeting"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "\u0000binary",
      "/tmp/greeting.bin"
    ],
    "name": "write raw greeting"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "{\n  \"key\": \"value\"\n}",
      "/tmp/config.json"
    ],
    "name": "write config"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "{\n  \"text\": \"bye proto\"\n}",
      "/tmp/greeting.json"
    ],
    "name": "write proto greeting"
  },
  {
    "name": "$result"
  }
]
