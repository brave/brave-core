[
  {
    "cmd": [
      "git",
      "clone",
      "--depth",
      "1",
      "https://chromium.googlesource.com/chromium/tools/depot_tools",
      "[WORKSPACE]/b/src/third_party/depot_tools"
    ],
    "name": "clone depot_tools"
  },
  {
    "cmd": [
      "gclient"
    ],
    "name": "verify gclient"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "-u",
      "RECIPE_MODULE[file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[WORKSPACE]/b/src/brave/infra/config/generated/builders/linux-x64-asan-brave/targets/brave.sanitisers.json",
      "/path/to/tmp/"
    ],
    "name": "read test spec (brave.sanitisers.json)"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "[WORKSPACE]/b/src/brave/tools/recipes/runtest.py",
      "--build-dir",
      "[WORKSPACE]/b/src/out/linux-x64-asan-brave",
      "--builder",
      "linux-x64-asan-brave",
      "--builder-name=linux-x64-asan-brave",
      "--builder-group=brave.sanitisers",
      "--test-type=brave_unit_tests",
      "--parse-gtest-output",
      "--sanitizer-reports-output",
      "/path/to/tmp/json",
      "brave_unit_tests"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "brave_unit_tests"
  },
  {
    "cmd": [
      "[WORKSPACE]/b/src/third_party/depot_tools/vpython3",
      "[WORKSPACE]/b/src/brave/tools/recipes/runtest.py",
      "--build-dir",
      "[WORKSPACE]/b/src/out/linux-x64-asan-brave",
      "--builder",
      "linux-x64-asan-brave",
      "--builder-name=linux-x64-asan-brave",
      "--builder-group=brave.sanitisers",
      "--test-type=brave_browser_tests",
      "--parse-gtest-output",
      "--sanitizer-reports-output",
      "/path/to/tmp/json",
      "brave_browser_tests"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "env": {
      "CHROME_HEADLESS": "1"
    },
    "env_prefixes": {
      "PATH": [
        "[WORKSPACE]/b/src/brave/tools/cr/bootstrap"
      ]
    },
    "name": "brave_browser_tests"
  },
  {
    "name": "$result"
  }
]
