[
  {
    "cmd": [
      "git",
      "clone",
      "--depth",
      "1",
      "https://chromium.googlesource.com/chromium/tools/depot_tools",
      "[WORKSPACE]/b/src/third_party/depot_tools"
    ],
    "name": "clone depot_tools"
  },
  {
    "cmd": [
      "gclient"
    ],
    "name": "verify gclient"
  },
  {
    "cmd": [
      "git",
      "cache",
      "exists",
      "--quiet",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git"
    ],
    "name": "git cache populate exists (before)"
  },
  {
    "cmd": [
      "git",
      "cache",
      "populate",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git",
      "--reset-fetch-config",
      "--no-fetch-tags",
      "--ref",
      "refs/tags/v1.80.100"
    ],
    "name": "git cache populate"
  },
  {
    "cmd": [
      "git",
      "cache",
      "exists",
      "--quiet",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git"
    ],
    "name": "git cache populate exists (after)"
  },
  {
    "cmd": [
      "git",
      "cache",
      "exists",
      "--quiet",
      "--cache-dir",
      "/b/cache",
      "https://github.com/brave/brave-core.git"
    ],
    "name": "git cache exists"
  },
  {
    "cmd": [
      "git",
      "remote",
      "set-url",
      "origin",
      "/b/cache/github.com-brave-brave-core"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core point origin at git cache"
  },
  {
    "cmd": [
      "git",
      "remote",
      "set-url",
      "--push",
      "origin",
      "https://github.com/brave/brave-core.git"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core restore origin push url"
  },
  {
    "cmd": [
      "git",
      "fetch",
      "--no-show-forced-updates",
      "--no-tags",
      "origin",
      "refs/tags/v1.80.100:refs/tags/v1.80.100"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core fetch tag"
  },
  {
    "cmd": [
      "git",
      "checkout",
      "--force",
      "FETCH_HEAD"
    ],
    "cwd": "[WORKSPACE]/b/src/brave",
    "name": "brave-core checkout FETCH_HEAD"
  },
  {
    "name": "$result"
  }
]
