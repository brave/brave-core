# Sweep b: Brave disablements and defaults. See tools/cr/codehealth/scripts/sweep.py
# for the fields.
agentic_review {
  # Flips: a changed default is both removed and added; new and deleted features only add or remove one. Tests and about_flags never count.
  capability_groups {
    path_expression: ".*\\.(?:cc|h|mm)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*|.*about_flags\\.cc"
    content_patterns: "^-.*(?:FEATURE_(?:EN|DIS)ABLED_BY_DEFAULT|\\b(?:ENABLED|DISABLED)\\);|enable_if\\()"
    required_patterns: "^\\+.*(?:FEATURE_(?:EN|DIS)ABLED_BY_DEFAULT|\\b(?:ENABLED|DISABLED)\\);|enable_if\\()"
    rules: "tools/cr/codehealth/rules/defaults/feature-flips.md"
    rules: "tools/cr/codehealth/rules/defaults/feature-defaults-unittest-entries.md"
    rules: "tools/cr/codehealth/rules/defaults/pins-equal-to-upstream-default.md"
  }
  # New IPHs that ship enabled: Brave pins IPHs one by one, and a new feature
  # only adds a default, which the flips group above requires to be removed too.
  capability_groups {
    path_expression: "components/feature_engagement/public/feature_constants\\.cc"
    content_patterns: "^\\+.*FEATURE_ENABLED_BY_DEFAULT"
    rules: "tools/cr/codehealth/rules/defaults/feature-flips.md"
  }
  # Moves to TabFeatures and friends, by subject.
  capability_groups {
    subject_patterns: "(?i)\\b(?:TabFeatures|UnownedUserData|BrowserWindowFeatures|TabInterface)\\b"
    rules: "tools/cr/codehealth/rules/defaults/creation-moved-to-new-owner.md"
  }
  # Tab helpers removed from the lists that create them.
  capability_groups {
    path_expression: "chrome/browser/ui/tab_helpers\\.cc|chrome/browser/ui/tabs/tab_features\\.cc|chrome/browser/ui/browser_window/internal/browser_window_features\\.cc|.*/tab_helpers\\.cc"
    content_patterns: "^-.*(?:CreateForWebContents|make_unique<|::Create\\w*\\()"
    rules: "tools/cr/codehealth/rules/defaults/creation-moved-to-new-owner.md"
  }
  # Announced removals of an old path, which a Brave stub may sit on.
  capability_groups {
    path_expression: ".*\\.(?:cc|h|mm)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^\\+.*TODO\\([^)]*\\):.*\\bremove\\b.*\\bonce\\b.*\\bno longer needed\\b"
    rules: "tools/cr/codehealth/rules/defaults/stub-on-a-path-upstream-retires.md"
  }
  # New checks of features Brave names; tests never count.
  capability_groups {
    path_expression: ".*\\.(?:cc|h|mm)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^\\+.*IsEnabled\\(\\s*(?:\\w+::)*k[A-Z]\\w*"
    brave_mentions: "IsEnabled\\(\\s*(?:\\w+::)*(k[A-Z]\\w*)"
    rules: "tools/cr/codehealth/rules/defaults/disabled-flag-new-consumers.md"
  }
  # Removed checks of features Brave names.
  capability_groups {
    path_expression: ".*\\.(?:cc|h|mm)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^-.*IsEnabled\\(\\s*(?:\\w+::)*k[A-Z]\\w*"
    brave_mentions: "IsEnabled\\(\\s*(?:\\w+::)*(k[A-Z]\\w*)"
    rules: "tools/cr/codehealth/rules/defaults/pinned-features-stopped-checked.md"
  }
  # Removed features, and ORed checks, Brave names.
  capability_groups {
    path_expression: ".*\\.(?:cc|h|mm)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^-\\s*BASE_FEATURE\\(\\s*k\\w+"
    content_patterns: "^\\+.*\\|\\|.*IsEnabled\\(|^\\+.*IsEnabled\\(.*\\|\\|"
    brave_mentions: "(?:BASE_FEATURE\\(|IsEnabled\\()\\s*(?:\\w+::)*(k[A-Z]\\w*)"
    rules: "tools/cr/codehealth/rules/defaults/superseded-flags-and-or-predicates.md"
  }
  # Blink runtime features: names, statuses and their base features.
  capability_groups {
    path_expression: "third_party/blink/renderer/platform/runtime_enabled_features\\.json5"
    content_patterns: "^[-+]\\s*(?:name:|status:|\"\\w+\"\\s*:\\s*\"(?:stable|test|experimental)\"|copied_from_base_feature_if|base_feature_status|base_feature:)"
    rules: "tools/cr/codehealth/rules/defaults/blink-runtime-features.md"
  }
  # The `EnableFeatureFromString` names the range removed, which nothing else
  # checks.
  capability_groups {
    tool: "vpython3 tools/cr/codehealth/scripts/blink_runtime_names.py {old}..{new}"
    rules: "tools/cr/codehealth/rules/defaults/blink-runtime-features.md"
  }
  # Reads and registrations removed for prefs Brave names.
  capability_groups {
    path_expression: ".*\\.(?:cc|h|mm)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^-.*(?:Get(?:Boolean|Integer|String|Double|Dict|List|Value|Int64|Time|TimeDelta)|FindPreference|IsManagedPreference|Register\\w*Pref)\\(\\s*(?:\\w+::)*k[A-Z]\\w*"
    brave_mentions: "\\(\\s*(?:\\w+::)*(k[A-Z]\\w*)"
    rules: "tools/cr/codehealth/rules/defaults/prefs-upstream-stops-reading.md"
  }
  # New consumers of the profile predicates Brave overrides.
  capability_groups {
    path_expression: ".*\\.(?:cc|h|mm)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^\\+.*\\b(?:IsPrimaryOTRProfile|IsIncognitoProfile|GetPrimaryOTRProfile)\\("
    rules: "tools/cr/codehealth/rules/defaults/profile-types-and-predicates.md"
  }
  # Profile kinds.
  capability_groups {
    path_expression: "(?:chrome/browser/profiles|components/profile_metrics|chrome/browser/ui/profiles)/.*\\.h"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^[-+]\\s*k[A-Z]\\w*\\s*(?:=\\s*[^,]+)?,"
    rules: "tools/cr/codehealth/rules/defaults/profile-types-and-predicates.md"
  }
  # New enum values in headers and mojoms Brave includes.
  capability_groups {
    path_expression: ".*\\.(?:h|mojom)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*|.*/(?:features|\\w+_features|\\w+_switches|switches|pref_names|\\w+_pref_names|url_constants|\\w+_constants|constants)\\.h|.*histogram\\w*\\.h"
    content_patterns: "^\\+\\s*k[A-Z]\\w*\\s*(?:=\\s*[^,;]+)?,?\\s*(?://.*)?$"
    brave_mentions: "/(\\w+)\\.(?:h|mojom)$"
    rules: "tools/cr/codehealth/rules/defaults/new-enum-values-and-id-headroom.md"
  }
  # ID headroom.
  capability_groups {
    path_expression: "chrome/app/chrome_command_ids\\.h|.*syncable_prefs?_(?:ids|database)\\w*\\.(?:h|cc)"
    content_patterns: "^\\+"
    rules: "tools/cr/codehealth/rules/defaults/new-enum-values-and-id-headroom.md"
  }
  # Mixer assignments on IDs Brave names, including an ID defaulted to one.
  capability_groups {
    path_expression: "(?:chrome/browser/ui/color|ui/color|ui/gtk|ui/qt|chrome/browser/themes)/.*\\.(?:cc|h)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^\\+.*mixer\\[(?:ui::)?k\\w+\\]"
    brave_mentions: "(?:mixer\\[|=\\s*\\{)\\s*(?:ui::)?(k\\w+)"
    rules: "tools/cr/codehealth/rules/defaults/color-pins.md"
  }
  # ThemeService::GetColorProviderKey().
  capability_groups {
    path_expression: "chrome/browser/themes/theme_service\\.cc"
    content_patterns: "^[-+].*\\b(?:key\\.\\w+|GetIsGrayscale|GetColorProviderKey|user_color\\w*)\\b"
    rules: "tools/cr/codehealth/rules/defaults/color-pins.md"
  }
  # Component installers.
  capability_groups {
    path_expression: ".*\\.(?:cc|h)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^\\+.*(?:kPublicKeySHA256|kSha2Hash|Register\\w+Component\\(|ComponentInstallerPolicy\\b)"
    rules: "tools/cr/codehealth/rules/defaults/component-updater-downloads.md"
  }
  # Flips of features that deliver models and components.
  capability_groups {
    path_expression: ".*(?:component|model|download|updater|deliver)\\w*\\.(?:cc|h)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^-.*(?:FEATURE_(?:EN|DIS)ABLED_BY_DEFAULT|\\b(?:ENABLED|DISABLED)\\);|enable_if\\()"
    required_patterns: "^\\+.*(?:FEATURE_(?:EN|DIS)ABLED_BY_DEFAULT|\\b(?:ENABLED|DISABLED)\\);|enable_if\\()"
    rules: "tools/cr/codehealth/rules/defaults/component-updater-downloads.md"
  }
  # Origin trials and the Android Glic list.
  capability_groups {
    path_expression: "third_party/blink/renderer/platform/runtime_enabled_features\\.json5|third_party/blink/common/origin_trials/.*|.*/GlicEnabling\\.java"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|h|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^[-+].*(?:origin_trial_feature_name|OriginTrialFeature::|\\bk\\w+)|^[-+]\\s*(?:public|private|static).*\\("
    rules: "tools/cr/codehealth/rules/defaults/other-feature-lists.md"
  }
  # Deletion and pref clearing added to non-test code: what a removal campaign
  # adds to wipe the feature's data on startup.
  capability_groups {
    path_expression: ".*\\.(?:cc|mm)"
    exclude_path_expression: ".*(?:_unittest|_browsertest|_test|_uitest|_test_util|_test_utils|_fuzzer|_perftest)\\.(?:cc|mm)|.*/test/.*|.*/testing/.*"
    content_patterns: "^\\+.*(?:sql::Database::Delete|DeletePathRecursively|ClearPref\\(|(?i:delete (?:the )?(?:residual|deprecated|obsolete)))"
    rules: "tools/cr/codehealth/rules/defaults/upstream-removes-feature-brave-keeps.md"
  }
}
