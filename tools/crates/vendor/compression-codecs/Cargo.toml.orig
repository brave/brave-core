[package]
name = "compression-codecs"
version = "0.4.48"
description = """
Adaptors for various compression algorithms.
"""
keywords = ["compression", "codec", "gzip", "zstd", "brotli"]
authors.workspace = true
categories.workspace = true
edition.workspace = true
license.workspace = true
readme = "../../README.md"
repository.workspace = true
rust-version.workspace = true

[package.metadata.docs.rs]
all-features = true
rustc-args = ["--cfg", "async_compression_unstable"]
rustdoc-args = ["--cfg", "async_compression_unstable"]

[features]
all-algorithms = [
    "brotli",
    "bzip2",
    "deflate",
    "gzip",
    "lz4",
    "lzma",
    "xz-parallel",
    "xz",
    "zlib",
    "zstd",
    "deflate64",
]

# algorithms
# Unstable, also requires `--cfg async_compression_unstable`.
brotli-mbrotli = ["dep:mbrotli"]
deflate = ["flate2"]
gzip = ["flate2", "memchr"]
lz4 = ["dep:lz4"]
lzma = ["dep:liblzma"]
xz = ["lzma"]
xz-parallel = ["xz", "liblzma/parallel"]
xz2 = ["xz"]
zlib = ["flate2"]
zstd = ["libzstd", "zstd-safe"]
zstdmt = ["zstd", "zstd-safe/zstdmt"]
# Unstable, also requires `--cfg async_compression_unstable`.
zstd-mzstd = ["dep:mzstd"]
# Unstable, also requires `--cfg async_compression_unstable`.
zstd-zrip = ["dep:zrip"]
deflate64 = ["dep:deflate64"]

[dependencies]
# Workspace dependencies.
compression-core.workspace = true
# features
brotli = { version = "9", optional = true }
bzip2 = { version = "0.6.1", optional = true }
deflate64 = { version = "0.1.10", optional = true }
flate2 = { version = "1.1.4", optional = true }
libzstd = { package = "zstd", version = "0.14.0", optional = true, default-features = false }
lz4 = { version = "1.28.1", optional = true }
liblzma = { version = "0.4.5", optional = true }
memchr = { version = "2", optional = true }
mbrotli = { version = "0.5.3", optional = true, default-features = false, features = [
    "std",
    "compression",
    "decompression",
] }
mzstd = { version = "0.2.6", optional = true, default-features = false, features = [
    "std",
    "compression",
    "decompression",
] }
zrip = { version = "0.8.22", optional = true, default-features = false, features = ["std", "ldm", "simd"] }
zstd-safe = { version = "8", optional = true, default-features = false }

[lints]
workspace = true
