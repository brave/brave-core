bench_ref_type_from_prefix_with_elems_dynamic_padding:
	mov rax, rdi
	movabs rdi, 3074457345618258598
	cmp rcx, rdi
	ja .LBB5_2
	lea rdi, [rcx + 2*rcx]
	or rdi, 3
	add rdi, 9
	test sil, 3
	setne r8b
	cmp rdi, rdx
	seta dl
	or dl, r8b
	cmp dl, 1
	jne .LBB5_3
.LBB5_2:
	mov qword ptr [rax], 0
	ret
.LBB5_3:
	mov qword ptr [rax], rsi
	mov qword ptr [rax + 8], rdi
	mov qword ptr [rax + 16], rcx
	ret
