import("//brave/components/brave_wallet/common/buildflags/buildflags.gni")

assert(enable_brave_wallet)
assert(enable_snap)

import("//brave/components/common/typescript.gni")
import("//mojo/public/tools/bindings/mojom.gni")
import("//tools/grit/preprocess_if_expr.gni")
import("//tools/grit/repack.gni")

transpile_web_ui("snaps_container_ui") {
  output_module = false
  entry_points = [ [
        "snaps_container",
        rebase_path("snaps_container.ts"),
      ] ]
  webpack_aliases = [ "browser" ]
  resource_name = "snaps_container"

  imports_from = [ "//brave/components/brave_wallet_ui/" ]

  deps = [
    "//brave/components/brave_wallet/common:mojom_js",
    "//brave/components/brave_wallet/common:preprocess_mojo",
  ]
}

pack_web_resources("snaps_container_generated") {
  resource_name = "snaps_container"
  output_dir = "$root_gen_dir/brave/components/snaps_container/resources"
  deps = [ ":snaps_container_ui" ]
}
