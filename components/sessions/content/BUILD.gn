import("//brave/components/containers/buildflags/buildflags.gni")

source_set("chromium_impl") {
  visibility = [ "//components/sessions" ]

  sources = [
    "content_serialized_navigation_builder.cc",
    "content_serialized_navigation_driver.cc",
  ]

  configs += [ "//components/sessions:implementation" ]

  deps = [
    "//base",
    "//brave/components/containers/buildflags",
    "//components/sessions:shared",
    "//content/public/browser",
    "//content/public/common",
    "//third_party/blink/public/common",
    "//url",
  ]

  if (enable_containers) {
    deps += [
      "//brave/components/containers/content/browser",
      "//brave/components/containers/core/common",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "brave_content_serialized_navigation_driver_unittest.cc" ]

  deps = [
    "//base/test:test_support",
    "//components/sessions:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}
