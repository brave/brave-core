import("//build/config/features.gni")

static_library("browser") {
  sources = [
    "query_filter_component_installer.cc",
    "query_filter_component_installer.h",
    "query_filter_data.cc",
    "query_filter_data.h",
    "utils.cc",
    "utils.h",
  ]

  public_deps = [
    "//base",
    "//brave/components/query_filter/common:schema",
    "//components/component_updater",
    "//components/update_client",
    "//url",
  ]

  deps = [
    "//brave/components/brave_component_updater/browser:public",
    "//brave/components/query_filter/common",
    "//brave/components/query_filter/common/internal",
    "//components/url_pattern_index",
    "//net",
    "//third_party/re2",
  ]
}

if (use_blink) {
  static_library("throttle") {
    sources = [
      "query_filter_throttle.cc",
      "query_filter_throttle.h",
    ]

    public_deps = [ "//third_party/blink/public/common" ]

    deps = [
      "//base",
      "//brave/components/brave_shields/core/browser",
      "//brave/components/query_filter/common",
      "//net",
      "//services/network/public/cpp",
      "//url",
    ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "query_filter_component_installer_unittest.cc",
    "query_filter_data_unittest.cc",
    "utils_unittest.cc",
  ]

  deps = [
    ":browser",
    "//base",
    "//base/test:test_support",
    "//brave/components/brave_component_updater/browser:test_support",
    "//brave/components/query_filter/browser/test_support",
    "//brave/components/query_filter/common",
    "//brave/components/query_filter/common/internal:unit_tests",
    "//components/component_updater:test_support",
    "//components/update_client",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]

  if (use_blink) {
    sources += [ "query_filter_throttle_unittest.cc" ]
    deps += [
      ":throttle",
      "//brave/components/brave_shields/core/browser",
      "//components/content_settings/core/browser",
      "//components/prefs:test_support",
      "//components/sync_preferences:test_support",
      "//net",
      "//services/network/public/cpp",
      "//third_party/blink/public/common",
    ]
  }
}
