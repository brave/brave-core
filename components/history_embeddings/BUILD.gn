import("//brave/components/local_ai/buildflags/buildflags.gni")

assert(enable_local_ai)

source_set("history_embeddings") {
  sources = [ "content/brave_history_embeddings_helpers.h" ]

  deps = [
    "//components/history_embeddings/content",
    "//components/page_content_annotations/core",
  ]
}

static_library("open_tab_passages") {
  public = [ "content/open_tab_passages.h" ]
  sources = [ "content/open_tab_passages.cc" ]

  public_deps = [ "//base" ]

  deps = [
    "//components/history/core/browser",
    "//components/history_embeddings/content",
    "//components/history_embeddings/core",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "content/open_tab_passages_unittest.cc" ]

  deps = [
    ":open_tab_passages",
    "//base",
    "//base/test:test_support",
    "//components/feature_engagement/test:test_support",
    "//components/history/core/browser",
    "//components/history/core/test",
    "//components/history_embeddings/content",
    "//components/history_embeddings/core",
    "//components/optimization_guide/core:test_support",
    "//components/os_crypt/async/browser:test_support",
    "//components/page_content_annotations/content",
    "//components/page_content_annotations/content:page_embeddings",
    "//components/page_content_annotations/core:test_support",
    "//components/passage_embeddings/core:test_support",
    "//testing/gtest",
    "//url",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "test/fake_history_embeddings_search.cc",
    "test/fake_history_embeddings_search.h",
  ]
  public_deps = [
    "//components/history/core/browser",
    "//components/history_embeddings/core",
  ]
  deps = [
    "//base",
    "//url",
  ]
}
