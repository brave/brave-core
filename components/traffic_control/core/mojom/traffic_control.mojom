module traffic_control.mojom;

// Match criteria for a traffic control rule. Fields are optional so rules can
// grow additional conditions over time without breaking older clients.
struct Condition {
  // Freeform URL filter text (policy URL-blocklist syntax). May contain
  // multiple patterns (one per line), blank lines, and `#` comments. When
  // unset, the rule does not match based on URL. Matching code trims each line
  // and ignores blanks/comments.
  string? url_filter;
};

// Destination for a matched rule.
struct Target {
  // Container to open matched traffic in.
  // - unset: no container destination chosen for this rule
  // - empty string: open in a non-contained tab (even if the current tab is
  //   in a container)
  // - non-empty: open in the container with this id
  // Mutually exclusive with `temporary_container`.
  string? container_id;
  // When true, open matched traffic in a newly created temporary container.
  // Mutually exclusive with `container_id`.
  bool temporary_container;
};

// Represents a traffic control rule that matches URLs and routes them to a
// target. Rules are evaluated in list order; the first enabled match wins.
struct TrafficRule {
  // Unique identifier for the rule.
  string id;
  // Whether the rule is active.
  bool enabled;
  // Match criteria for this rule.
  Condition condition;
  // Destination for matched traffic.
  Target target;
};

// Represents an error that occurred during a rule CRUD operation.
enum RuleOperationError {
  // The rule ID is set, but the operation expects it to be empty.
  kIdShouldBeEmpty = 1,
  // The rule ID is not set, but the operation expects it to be non-empty.
  kIdShouldBeSet,
  // The condition struct is missing.
  kInvalidCondition,
  // The URL filter is invalid.
  kInvalidUrlFilter,
  // The target is invalid.
  kInvalidTarget,
  // The rule was not found.
  kNotFound,
};

// Interface for settings UI -> browser communication. This interface allows the
// settings UI to perform CRUD operations on traffic control rules, with all
// operations being handled in the browser process.
interface TrafficControlSettingsHandler {
  // Establishes a connection with the UI for browser -> UI notifications. This
  // creates a 1-to-1 connection between the handler and the settings UI.
  BindUI(pending_remote<TrafficControlSettingsUI> ui);

  // Retrieves the current list of rules. Returns: Array of all configured
  // rules.
  GetRules() => (array<TrafficRule> rules);

  // Creates a new rule.
  AddRule(TrafficRule rule) => (RuleOperationError? error);

  // Updates an existing rule.
  UpdateRule(TrafficRule rule) => (RuleOperationError? error);

  // Removes a rule by its ID.
  RemoveRule(string id) => (RuleOperationError? error);
};

// Interface for browser -> settings UI communication. This interface allows the
// browser process to notify the settings UI about changes to the rules list.
interface TrafficControlSettingsUI {
  // Notifies the settings UI when the rules list is modified. This ensures the
  // UI stays in sync with the browser-side rule state.
  // - `rules`: Updated list of all rules.
  OnRulesChanged(array<TrafficRule> rules);
};
