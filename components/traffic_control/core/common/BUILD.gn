import("//brave/components/traffic_control/buildflags/buildflags.gni")

assert(enable_traffic_control)

component("features") {
  defines = [ "IS_TRAFFIC_CONTROL_FEATURES_IMPL" ]

  sources = [
    "features.cc",
    "features.h",
  ]

  public_deps = [ "//brave/components/traffic_control/buildflags" ]
  deps = [ "//base" ]
}

group("common") {
  public_deps = [ ":features" ]
}
