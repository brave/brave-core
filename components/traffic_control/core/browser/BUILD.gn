import("//brave/components/traffic_control/buildflags/buildflags.gni")

assert(enable_traffic_control)

static_library("browser") {
  public = [
    "pref_names.h",
    "prefs_registration.h",
    "traffic_control_service.h",
    "traffic_control_settings_handler.h",
  ]

  sources = [
    "prefs.cc",
    "prefs.h",
    "prefs_registration.cc",
    "rule_validation.cc",
    "rule_validation.h",
    "traffic_control_service.cc",
    "traffic_control_settings_handler.cc",
  ]

  friend = [ ":unit_tests" ]

  public_deps = [ "//brave/components/traffic_control/core/mojom" ]

  deps = [
    "//base",
    "//brave/components/traffic_control/core/common",
    "//components/keyed_service/core",
    "//components/pref_registry",
    "//components/prefs",
    "//components/url_matcher",
    "//components/user_prefs",
    "//mojo/public/cpp/bindings",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "prefs_unittest.cc",
    "rule_validation_unittest.cc",
    "traffic_control_service_unittest.cc",
    "traffic_control_settings_handler_unittest.cc",
  ]

  deps = [
    ":browser",
    "//base",
    "//base/test:test_support",
    "//brave/components/traffic_control/core/common",
    "//components/sync_preferences:test_support",
    "//mojo/public/cpp/bindings",
    "//testing/gtest",
  ]
}
