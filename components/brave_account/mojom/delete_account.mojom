module brave_account.mojom;

struct DeleteAccountResult {
  // Currently empty, serves as a placeholder for success.
};

enum DeleteAccountClientErrorCode {
  kCalledInWrongState,
  kUnexpected,
  kAuthenticationTokenDecryptionFailed,
};

struct DeleteAccountClientError {
  DeleteAccountClientErrorCode error_code;
};

enum DeleteAccountServerErrorCode {
  // Sentinel: server returned a malformed response
  // (e.g. success body missing required fields).
  kInvalidResponse = -1,
  // Sentinel: server returned "code": null in the JSON body.
  kNull            = 0,
  // Sentinel: server returned an unrecognized "code" in the JSON body.
  kUnknown         = 1,
  // /v2/accounts:
  // - internal: -
  // - user-facing: -
};

struct DeleteAccountServerError {
  // < 0: network error code (net_error_list.h)
  // >= 0: HTTP status code (http_status_code_list.h) if available,
  //       otherwise net::OK
  int32 net_error_or_http_status;
  DeleteAccountServerErrorCode error_code;
};

union DeleteAccountError {
  DeleteAccountClientError client_error;
  DeleteAccountServerError server_error;
};
