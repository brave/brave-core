import("//brave/components/brave_wallet/common/buildflags/buildflags.gni")

assert(enable_snap)

source_set("snap") {
  sources = [
    "hidden_web_contents_snap_host_bridge_controller.cc",
    "hidden_web_contents_snap_host_bridge_controller.h",
  ]

  deps = [
    "//base",
    "//brave/components/brave_wallet/browser/snap/execution_environment",
    "//brave/components/brave_wallet/common",
    "//brave/components/brave_wallet/common:mojom",
    "//brave/components/restricted_web_contents_delegate",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//ui/base",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "hidden_web_contents_snap_host_bridge_controller_unittest.cc" ]

  deps = [
    ":snap",
    "//base/test:test_support",
    "//brave/components/brave_wallet/browser/snap/execution_environment",
    "//brave/components/brave_wallet/browser/snap/execution_environment:test_support",
    "//brave/components/brave_wallet/common",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}
