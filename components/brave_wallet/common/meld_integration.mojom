module brave_wallet.mojom;

import "brave/components/brave_wallet/common/mojom/brave_wallet_common.mojom";
import "mojo/public/mojom/base/time.mojom";

struct MeldLogoImages {
  string? dark_url;
  string? dark_short_url;
  string? light_url;
  string? light_short_url;
};

struct MeldServiceProvider {
  string? name;
  string service_provider;
  string status;
  string? web_site_url;
  array<string> categories;
  map<string, string> category_statuses;
  MeldLogoImages? logo_images;
};

struct MeldCryptoQuote {
  string? transaction_type;
  string? exchange_rate;
  string? transaction_fee;
  string? source_currency_code;
  string? source_amount;
  string? source_amount_without_fee;
  string? fiat_amount_without_fees;
  string? total_fee;
  string? network_fee;
  string? payment_method;
  string? destination_currency_code;
  string? destination_amount;
  string? destination_amount_without_fees;
  string? customer_score;
  string? service_provider;
  string? country_code;
};

struct MeldPaymentMethod {
  string payment_method;
  string? name;
  string? payment_type;
  MeldLogoImages? logo_images;
};

struct MeldFiatCurrency {
  string currency_code;
  string? name;
  string? symbol_image_url;
};

struct MeldCryptoCurrency {
  CoinType coin;
  string chain_id;
  
  string currency_code;
  string? name;
  string? chain_code;
  string? chain_name;
  string? contract_address;
  string? symbol_image_url;
};

struct MeldCountry {
  string country_code;
  string? name;
  string? flag_image_url;
};

struct CryptoBuySessionData {
  string country_code;
  string destination_currency_code;
  array<string>? lock_fields;
  string? payment_method_type;
  string? redirect_url;
  string service_provider;
  string source_amount;
  string source_currency_code;
  string wallet_address;
  string? wallet_tag;
};

struct CryptoSellSessionData {
  string country_code;
  string destination_currency_code;
  array<string>? lock_fields;
  string? payment_method_type;
  string? redirect_url;
  string service_provider;
  string source_amount;
  string source_currency_code;
  string? wallet_address;
  string? wallet_tag;
};

struct CryptoTransferSessionData {
  string? country_code;
  string? institution_id;
  array<string>? lock_fields;
  string? redirect_url;
  string service_provider;
  string? source_amount;
  array<string> source_currency_codes;
  string? wallet_address;
  string? wallet_tag;
};

struct CustomerObject {
  string email;
};

struct CryptoWidgetCustomerData {
  CustomerObject? customer;
  string? customer_id;
  string? external_customer_id;
  string? external_session_id;
};

struct MeldCryptoWidget {
  string id;
  string? external_session_id;
  string? external_customer_id;
  string customer_id;
  string widget_url;
  string token;
};

interface MeldIntegrationService {
  // Obtains the list of Service Providers
  GetServiceProviders() => (array<MeldServiceProvider>? service_providers,
                            array<string>? error);

  // Obtains the crypto quotes
  // Note that next parameters are mandatory:
  // destination_currency_code, country, source_amount, source_currency_code
  GetCryptoQuotes(string country,
                  string source_currency_code,
                  string destination_currency_code,
                  double source_amount,
                  string? account,
                  string? payment_method)
      => (array<MeldCryptoQuote>? crypto_quotes, array<string>? error);

  // Obtains the list of payment methods
  GetPaymentMethods(string country, string source_currency_code)
      => (array<MeldPaymentMethod>? payment_methods, array<string>? error);

  // Obtains the list of fiat currencies
  GetFiatCurrencies()
      => (array<MeldFiatCurrency>? fiat_currencies, array<string>? error);

  // Obtains the list of crypto currencies
  GetCryptoCurrencies()
      => (array<MeldCryptoCurrency>? fiat_currencies, array<string>? error);

  // Obtains the list of countries
  GetCountries() => (array<MeldCountry>? countries, array<string>? error);

  CryptoBuyWidgetCreate(CryptoBuySessionData session_data,
                        CryptoWidgetCustomerData? customer_data)
      => (MeldCryptoWidget? widget_data, array<string>? error);

  CryptoSellWidgetCreate(CryptoSellSessionData session_data,
                         CryptoWidgetCustomerData? customer_data)
      => (MeldCryptoWidget? widget_data, array<string>? error);

  CryptoTransferWidgetCreate(CryptoTransferSessionData session_data,
                             CryptoWidgetCustomerData? customer_data)
      => (MeldCryptoWidget? widget_data, array<string>? error);
};
