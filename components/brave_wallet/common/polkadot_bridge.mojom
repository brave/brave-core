module brave_wallet.mojom;

import "brave/components/brave_wallet/common/brave_wallet.mojom";

struct PolkadotDecodedPayload {
  string? as_human;

  // Necessary for accurate fee estimation via the Polkadot RPC nodes.
  array<uint8>? mock_signed_extrinsic;

  // The signature payload we'll have our keyring actually sign. This is
  // generated by @polkadot/types.
  array<uint8>? signature_payload;

  string? error;
};

interface PolkadotBridge {
  Decode(array<uint8> metadata_bytes,
         PolkadotChainProperties chain_properties,
         string raw_payload_json)
      => (PolkadotDecodedPayload? decoded);
};

interface PolkadotBridgeUIHandler {
  BindPolkadotBridge(pending_remote<PolkadotBridge> bridge);
};
