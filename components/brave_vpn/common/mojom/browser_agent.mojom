module brave_vpn.mojom;

// Newest version of the browser to agent contract below, sent by browsers in
// Initialize(). The agent accepts a range of versions rather than an exact
// match, so a browser and agent from different updates can still talk; it
// answers anything outside that range with InitializeResult::kVersionMismatch.
// Bump on an incompatible change, and prefer [MinVersion] for additive ones.
//
// Note that on official desktop builds message ID scrambling already stops
// binaries from different Brave versions exchanging messages at all, so this
// handshake is only reachable between binaries sharing that salt.
const uint32 kProtocolVersion = 1;

// VPN connection state maintained by the agent.
enum VpnConnectionState {
  kDisconnected,
  kConnected,
  kDisconnecting,
  kConnecting,
  kConnectFailed,
  kInternalError,
};

// VPN region information. Intentionally decoupled from V1 and UI Region
// structure, as it is not intended to be compatible.
struct VpnRegion {
  string name;
};

// Browser's subordinate surface, passed to the agent's BrowserHost, so the
// agent can call back into the browser once it accepts. Members passing the
// current state are called as soon as the BrowserHost is bound, then on
// every change.
interface BrowserEndpoint {
  // Updates the current VPN connection state. |error_message| is set for error
  // states, and null is passed otherwise.
  OnConnectionStateChanged(VpnConnectionState state, string? error_message);

  // Updates the currently selected VPN region.
  OnSelectedRegionChanged(VpnRegion region);

  // Updates the current auto-reconnect state.
  OnAutoReconnectStateChanged(bool enabled);

  // Updates the current Smart Proxy routing state.
  OnSmartProxyRoutingStateChanged(bool enabled);

  // Updates the current Allow Lan Traffic state. |available| means that the
  // feature is available for the current platform and version.
  OnAllowLanTrafficStateChanged(bool available, bool enabled);

  // Updates the last hostname the VPN was connected to, or was trying to
  // connect to; can be used for submitting technical support tickets and for
  // debugging purposes.
  OnLastHostnameChanged(string hostname);
};

enum InitializeResult {
  kSuccess,
  kVersionMismatch,
  kNotIdentified,
  kRejected,
  kInconclusive,
  kInvalidRequest,
};

enum BindBrowserHostResult {
  kSuccess,
  kUninitialized,
  kAlreadyBound,
};

// The browser's connection to the agent, and the only interface reachable on
// a fresh connection. The browser MUST keep this remote alive for as long as
// it uses the BrowserHost obtained from it. The underlying transport is bound
// to this receiver, so dropping it tears down the whole connection,
// BrowserHost included.
interface BrowserHostProvider {
  // First call on a connection, and the one that authenticates the browser.
  // Settles the protocol version, then verifies the calling browser, which may
  // take a while: the reply arrives once that verdict is in. Also hands over
  // the optional channel the agent identifies itself on where the platform
  // requires the agent to speak before it can be identified at all; the agent
  // answers that channel only once it has accepted the browser, so it never
  // self-identifies to a peer it has not verified. May succeed only once.
  // Calling it again after it has succeeded, is answered with kInvalidRequest.
  Initialize(uint32 protocol_version, handle<platform>? identity_channel)
      => (InitializeResult result);

  // Asks for the authenticated API surface. The browser was already verified
  // during Initialize(), so this only binds. A browser that drops its host may
  // ask again on the same connection without being re-verified; a request
  // while one is already bound is answered with kAlreadyBound.
  BindBrowserHost(pending_remote<BrowserEndpoint> browser_endpoint,
                  pending_receiver<BrowserHost> host)
                    => (BindBrowserHostResult result);
};

// Agent browser-facing real API surface, owns the VPN related functionality
// passed to the authenticated browsers.
interface BrowserHost {
  // Starts connecting the VPN.
  Connect();

  // Disconnects the VPN.
  Disconnect();

  // Clears a failure state and its error message, returning to kDisconnected
  // without connecting.
  ResetConnectionState();

  // Gets information about all available regions from an internal cache which
  // is fetched from the VPN provider.
  GetAllRegions() => (array<VpnRegion> regions);

  // Sets the desired region to connect to. The agent may decline; an actual
  // change is reported through the corresponding BrowserEndpoint callback.
  SetSelectedRegion(VpnRegion region);

  // Requests an auto-reconnect state change. The agent may decline; an
  // actual change is reported through the corresponding BrowserEndpoint
  // callback.
  SetAutoReconnectState(bool enable);

  // Requests a Smart Proxy routing state change. The agent may decline; an
  // actual change is reported through the corresponding BrowserEndpoint
  // callback.
  SetSmartProxyRoutingState(bool enable);

  // Requests an Allow LAN traffic state change. The agent may decline; an
  // actual change is reported through the corresponding BrowserEndpoint
  // callback.
  SetAllowLanTrafficState(bool enable);
};
