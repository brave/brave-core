include_rules = [
  "+components/autofill",
  "+content/public/browser",
  "+mojo/public/cpp/bindings",
  "+services/service_manager/public/cpp",
  "+third_party/re2",
]

specific_include_rules = {
  ".*unittest\.cc": [
    "+content/public/test",
    # `brave_unit_tests` links the real `BraveWebUIControllerFactory`, which
    # DCHECKs on a plain `content::TestBrowserContext` during a real
    # navigation; this harness is the only one that satisfies it.
    "+chrome/test/base/chrome_render_view_host_test_harness.h",
  ],
  ".*browsertest\.cc": [
    "+content/public/test",
    # `brave_browser_tests` needs the real browser test harness to drive
    # Autofill focus events through a live renderer.
    "+chrome/test/base/chrome_test_utils.h",
    "+chrome/test/base/platform_browser_test.h",
  ],
}
