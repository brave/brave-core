<?xml version="1.0" encoding="UTF-8"?>
<grit-part>
    <message name="IDS_PSST_CONSENT_DIALOG_TITLE" formatter_data="webui=Psst" desc="A title for a dialog to adjust PSST">
        Privacy Settings Tuning
    </message>
    <message name="IDS_PSST_CONSENT_DIALOG_BODY" formatter_data="webui=Psst" desc="A body for a dialog to adjust PSST">
        This website offers privacy settings that Brave can automatically adjust for you. Here's what we recommend:
    </message>
    <message name="IDS_PSST_COMPLETE_CONSENT_DIALOG_OK" formatter_data="webui=Psst" desc="Ok button's Text for PSST consent dialog, allows user to apply recommended privacy settings">
        Apply Changes
    </message>
    <message name="IDS_PSST_COMPLETE_CONSENT_DIALOG_REPORT_FAILED" formatter_data="webui=Psst" desc="Report failed button's Text for PSST consent dialog, allows user to report failed content">
        Report Failed Steps
    </message>
    <message name="IDS_PSST_COMPLETE_CONSENT_DIALOG_CLOSE" formatter_data="webui=Psst" desc="Close button's Text for PSST consent dialog, allows to close the dialog when privacy setting are applied">
        Close
    </message>
    <message name="IDS_PSST_COMPLETE_CONSENT_DIALOG_CANCEL" formatter_data="webui=Psst" desc="Cancel button's Text for PSST consent dialog, allows user to decline the applying recommended privacy settings">
        Cancel
    </message>
    <message name="IDS_PSST_COMPLETE_CONSENT_DIALOG_FAILED" formatter_data="webui=Psst" desc="Common failed state text for PSST consent dialog tasks, displayed when the whole operation broken and could not be completed">
        Task completion failed
    </message>
    <message name="IDS_PSST_REPORT_DIALOG_TITLE" formatter_data="webui=Psst" desc="Title for the screen used to report failed PSST steps to Brave">
        Report failed steps
    </message>
    <message name="IDS_PSST_REPORT_DIALOG_BODY" formatter_data="webui=Psst" desc="Body text for the screen used to report failed PSST steps to Brave">
        Send a report of the failed steps to the Brave team. This report will contain the information needed for us to fix the issue. <ph name="LINK_BEFORE">$1</ph>Learn more.<ph name="LINK_AFTER">/$1</ph>
    </message>
    <message name="IDS_PSST_REPORT_DIALOG_BODY_LEARN_MORE_LINK" formatter_data="webui=Psst" desc="Url for the report dialog body learn more link">
        https://support.brave.app/hc/en-us/articles/47405731650957
    </message>
    <message name="IDS_PSST_REPORT_DIALOG_CURRENT_URL_LABEL" formatter_data="webui=Psst" desc="Label for the current site URL shown on the PSST failed steps report screen">
        Current URL
    </message>
    <message name="IDS_PSST_REPORT_DIALOG_FAILED_STEPS_LABEL" formatter_data="webui=Psst" desc="Label for the list of failed steps shown on the PSST failed steps report screen">
        Failed step(s)
    </message>
    <message name="IDS_PSST_REPORT_DIALOG_SEND_BUTTON" formatter_data="webui=Psst" desc="Button text to send the PSST failed steps report to Brave">
        Send report
    </message>
    <message name="IDS_PSST_REPORT_DIALOG_SENT_BUTTON" formatter_data="webui=Psst" desc="Button text shown after the PSST failed steps report has been sent">
        Report sent
    </message>
    <message name="IDS_PSST_REPORT_DIALOG_SENT_MESSAGE" formatter_data="webui=Psst" desc="Confirmation message shown after the PSST failed steps report has been sent">
        Thanks for letting Brave's developers know that there's something wrong with this site. We'll do our best to fix it!
    </message>
</grit-part>
