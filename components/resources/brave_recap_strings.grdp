<?xml version="1.0" encoding="UTF-8"?>
<grit-part>
  <message name="IDS_BRAVE_RECAP_TITLE" desc="Title of the Brave Recap page, a summary of what Brave Shields has blocked and saved for the user" formatter_data="webui=BraveRecap">
    Brave Shields recap
  </message>
  <message name="IDS_BRAVE_RECAP_INTRO_HEADING" desc="Heading of the first Brave Recap slide" formatter_data="webui=BraveRecap">
    Your Brave Shields recap is here!
  </message>
  <message name="IDS_BRAVE_RECAP_INTRO_SINCE" desc="Text on the first slide. $1 is a month and year, e.g. 'October 2024', and is highlighted." formatter_data="webui=BraveRecap">
    Since <ph name="MONTH_YEAR">$1<ex>October 2024</ex></ph>, Brave Shields has been keeping you safe by blocking third-party ads and trackers
  </message>
  <message name="IDS_BRAVE_RECAP_INTRO_DAYS" desc="Text on the first slide. $1 is a number of days, always more than one, and is highlighted." formatter_data="webui=BraveRecap">
    That's <ph name="DAYS">$1<ex>731</ex></ph> days of browsing with peace of mind!
  </message>
  <message name="IDS_BRAVE_RECAP_INTRO_NO_DATE" desc="Text on the first slide when the install date is unknown." formatter_data="webui=BraveRecap">
    Brave Shields keeps you safe by blocking third-party ads and trackers
  </message>
  <message name="IDS_BRAVE_RECAP_HELP_LABEL" desc="Accessible label for the button on the first slide that shows how Brave Recap handles the user's data" formatter_data="webui=BraveRecap">
    About your recap data
  </message>
  <message name="IDS_BRAVE_RECAP_GET_STARTED" desc="Button on the first slide that starts the recap" formatter_data="webui=BraveRecap">
    Get started
  </message>
  <message name="IDS_BRAVE_RECAP_BLOCKED_HEADING" desc="Label under the number of ads and trackers blocked" formatter_data="webui=BraveRecap">
    ads &amp; trackers blocked
  </message>
  <message name="IDS_BRAVE_RECAP_BLOCKED_TEXT" desc="Explanation on the ads and trackers blocked slide" formatter_data="webui=BraveRecap">
    Each one wanted to watch, profile or interrupt you, and none of them got to
  </message>
  <message name="IDS_BRAVE_RECAP_TIME_HEADING" desc="Label under the amount of time saved on the share image, after a number and unit, e.g. '3.6 hours'" formatter_data="webui=BraveRecap">
    of waiting saved
  </message>
  <message name="IDS_BRAVE_RECAP_TIME_CAPTION" desc="Label under the large number on the time saved slide. $1 is a time unit, e.g. 'hours' or 'minutes'." formatter_data="webui=BraveRecap">
    <ph name="UNIT">$1<ex>hours</ex></ph> of waiting saved
  </message>
  <message name="IDS_BRAVE_RECAP_TIME_TEXT" desc="Explanation on the time saved slide" formatter_data="webui=BraveRecap">
    Time spent on what you came for, not on what came for you
  </message>
  <message name="IDS_BRAVE_RECAP_DATA_HEADING" desc="Label under the amount of data saved on the share image, after a number and unit, e.g. '8.83 GB'" formatter_data="webui=BraveRecap">
    of data saved
  </message>
  <message name="IDS_BRAVE_RECAP_DATA_CAPTION" desc="Label under the large number on the data saved slide. $1 is a data unit, e.g. 'GB' or 'MB'." formatter_data="webui=BraveRecap">
    <ph name="UNIT">$1<ex>GB</ex></ph> of data saved
  </message>
  <message name="IDS_BRAVE_RECAP_DATA_TEXT" desc="Explanation on the data saved slide" formatter_data="webui=BraveRecap">
    Every ad costs data, and yours went to what you actually wanted
  </message>
  <message name="IDS_BRAVE_RECAP_PRIVACY_NOTE" desc="Tooltip on the first slide saying the stats are stored only on the device and Brave never receives them" formatter_data="webui=BraveRecap">
    Brave never sees your browsing. These rough counts stay on your device.
  </message>
  <message name="IDS_BRAVE_RECAP_DOWNLOAD" desc="Button to download the share image" formatter_data="webui=BraveRecap">
    Download image
  </message>
  <message name="IDS_BRAVE_RECAP_POST_ON_X" desc="Button to share on X" formatter_data="webui=BraveRecap">
    Post on X
  </message>
  <message name="IDS_BRAVE_RECAP_POST_ON_REDDIT" desc="Button to share on Reddit" formatter_data="webui=BraveRecap">
    Post on Reddit
  </message>
  <message name="IDS_BRAVE_RECAP_IMAGE_COPIED" desc="Shown after the share image is copied to the clipboard and X or Reddit opens in a new tab, since those sites can't receive the image directly" formatter_data="webui=BraveRecap">
    Image copied. Paste it into your post to include it.
  </message>
  <message name="IDS_BRAVE_RECAP_SHARE_POST_TEXT" desc="Prefilled social post on X, and the body of the prefilled Reddit post. $1 is a count of ads and trackers, $2 a duration, $3 an amount of data." formatter_data="webui=BraveRecap">
    Brave has blocked <ph name="BLOCKED">$1<ex>184,213</ex></ph> ads and trackers for me, saving <ph name="TIME_SAVED">$2<ex>2.14 days</ex></ph> and <ph name="DATA_SAVED">$3<ex>6.9 GB</ex></ph> of data. Try it:
  </message>
  <message name="IDS_BRAVE_RECAP_SHARE_POST_TITLE" desc="Prefilled Reddit post title, required by Reddit. $1 is a count of ads and trackers." formatter_data="webui=BraveRecap">
    Brave has blocked <ph name="BLOCKED">$1<ex>184,213</ex></ph> ads and trackers for me
  </message>
  <message name="IDS_BRAVE_RECAP_CARD_TITLE" desc="Title on the share image" formatter_data="webui=BraveRecap">
    My Brave recap
  </message>
  <message name="IDS_BRAVE_RECAP_CARD_SINCE" desc="Subtitle on the share image. $1 is a month and year." formatter_data="webui=BraveRecap">
    Since <ph name="MONTH_YEAR">$1<ex>October 2024</ex></ph>
  </message>
  <message name="IDS_BRAVE_RECAP_CARD_CTA" desc="Call to action at the bottom of the share image" formatter_data="webui=BraveRecap">
    Get Brave at brave.com
  </message>
  <message name="IDS_BRAVE_RECAP_NEXT" desc="Button to go to the next slide" formatter_data="webui=BraveRecap">
    Next
  </message>
  <message name="IDS_BRAVE_RECAP_BACK" desc="Accessible label for the button that goes to the previous slide" formatter_data="webui=BraveRecap">
    Back
  </message>
  <message name="IDS_BRAVE_RECAP_SLIDES_LABEL" desc="Accessible label for the row of bars that shows which slide is open" formatter_data="webui=BraveRecap">
    Slides
  </message>
  <message name="IDS_BRAVE_RECAP_SLIDE_LABEL" desc="Accessible label for one bar in the slide indicator. $1 is the slide number, $2 the number of slides." formatter_data="webui=BraveRecap">
    Slide <ph name="NUMBER">$1<ex>2</ex></ph> of <ph name="COUNT">$2<ex>5</ex></ph>
  </message>
  <message name="IDS_BRAVE_RECAP_EMPTY_HEADING" desc="Heading when there are no stats yet" formatter_data="webui=BraveRecap">
    Nothing to recap yet
  </message>
  <message name="IDS_BRAVE_RECAP_EMPTY_TEXT" desc="Text when there are no stats yet" formatter_data="webui=BraveRecap">
    Brave hasn't blocked much yet. Browse for a while and come back to see what Shields has done for you.
  </message>
</grit-part>
