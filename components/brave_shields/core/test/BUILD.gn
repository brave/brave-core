import("//testing/test.gni")

source_set("test_support") {
  testonly = true

  sources = [
    "ad_block_service_test_observer.cc",
    "ad_block_service_test_observer.h",
    "ad_block_unit_test_helper.cc",
    "ad_block_unit_test_helper.h",
    "test_filters_provider.cc",
    "test_filters_provider.h",
  ]

