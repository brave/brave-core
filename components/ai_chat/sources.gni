import("//brave/components/ai_chat/core/common/buildflags/buildflags.gni")

# Deps for third_party/blink/renderer/modules/peerconnection.
# //brave/components/ai_chat/core/common:constants is a renderer-safe,
# header-only target so blink can read the AI Chat code sandbox WebUI host
# constant without depending on the rest of the AI Chat common component.
# Guarded on enable_ai_chat so that, in Brave Origin builds (where AI Chat is
# disabled), the ai_chat/core/common BUILD.gn is never loaded -- otherwise its
# headers would become "known" to `gn check`, making the conditional
# #if BUILDFLAG(ENABLE_AI_CHAT) includes in //brave/browser resolve and get
# flagged as missing-dependency errors.
brave_blink_renderer_modules_peerconnection_deps = []
if (enable_ai_chat) {
  brave_blink_renderer_modules_peerconnection_deps +=
      [ "//brave/components/ai_chat/core/common:constants" ]
}
