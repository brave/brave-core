module ai_chat.mojom;

import "mojo/public/mojom/base/time.mojom";

// A Dreaming run, for brave://leo-memory-internals.
struct DreamingRunRecord {
  uint64 id;
  // "timer", "dream_now" or "eval".
  string trigger;
  mojo_base.mojom.Time start_time;
  // Null while the run is active.
  mojo_base.mojom.Time? end_time;
  // How the run ended ("completed", "timed_out", ...), or "running".
  string status;
  // The steps of the run as a JSON list. Each step has "step" (its name) and
  // "t_ms" (the time since the start of the run). A step that asked the
  // decision model has "decision_requests": each request as sent and its
  // answer as received. An "llm_call" step has the prompts and the answer.
  string trace_json;
};

// The learned memory lookup of one chat turn: which memories went with the
// request to the chat model, and why.
struct TurnLookupRecord {
  uint64 id;
  string conversation_uuid;
  mojo_base.mojom.Time start_time;
  // Null while the lookup is active.
  mojo_base.mojom.Time? end_time;
  // The steps as a JSON list, the same shape as DreamingRunRecord.trace_json.
  // The last step ("done") has the reason the lookup ended and the memories
  // that went.
  string trace_json;
  // The request to the decision model as sent and its answer, as a JSON list.
  // "arrived_ms" can be after the end of the lookup when it timed out.
  string decision_requests_json;
};

// A change of a learned memory that is not a step of a Dreaming run: a choice
// of the user, the clean-up of old memories, or a save of the memory tool.
struct MemoryEventRecord {
  uint64 id;
  mojo_base.mojom.Time time;
  // "keep_forever", "release_keep_forever", "edited", "deleted",
  // "deleted_all", "expired", "tool_saved" or "tool_duplicate".
  string action;
  // The learned memory. Empty for a memory of the pref list and for
  // "deleted_all".
  string uuid;
  string text;
  // More about the event, as a JSON object.
  string details_json;
};

// Debugging of learned memory: what Dreaming and the chat turns asked the
// local models and what they answered. Nothing of it is stored on disk.
interface LearnedMemoryInternals {
  // The active run and the last runs, the newest first. |available| is false
  // when learned memory does not run in this profile.
  GetDreamingRuns() => (bool available, array<DreamingRunRecord> runs);

  // The last chat turn lookups, the newest first.
  GetTurnLookups() => (bool available, array<TurnLookupRecord> lookups);

  // The last memory events, the newest first.
  GetMemoryEvents() => (bool available, array<MemoryEventRecord> events);
};
