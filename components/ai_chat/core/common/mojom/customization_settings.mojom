module ai_chat.mojom;

import "mojo/public/mojom/base/time.mojom";

// Supported customization fields, each field can be empty as it might not be
// set.
struct Customizations {
  string name;
  string job;
  string tone;
  string other;
};

enum CustomizationOperationError {
  // Exceed the limit of a single customization or memory, or empty.
  kInvalidLength,
  // When a memory is not found, could happen when editing.
  kNotFound,
};

// Learned memory (Dreaming). The browser builds the learned memory code only on
// platforms with local AI. On other platforms the handler reports that learned
// memory is not available.
enum LearnedMemoryType {
  kPermanent,
  kLongTerm,
  kShortTerm,
};

enum LearnedMemoryCategory {
  kPreference,
  kPersonalFact,
  kTopic,
};

struct LearnedMemoryItem {
  string uuid;
  string text;
  LearnedMemoryCategory category;
  LearnedMemoryType type;
  mojo_base.mojom.Time created_time;
  mojo_base.mojom.Time updated_time;
  // The text before the last replace or merge, if any.
  string? previous_text;
  // The date when Leo forgets the memory if it does not use it before. Null
  // for a memory that the user keeps.
  mojo_base.mojom.Time? expire_time;
};

// A change that a Dreaming run wants to make. Nothing is stored before the
// user reviews it.
enum LearnedMemoryChange {
  // A memory that the run learned.
  kNew,
  // A memory with a new text: a replace or a merge.
  kChanged,
  // A memory that the run saw again. Only its dates and sources move.
  kSeenAgain,
};

// A sentence of a chat that a change of the review came from.
struct LearnedMemorySource {
  string sentence;
  // The chat and the message of the sentence, to open the chat at it.
  string conversation_uuid;
  string entry_uuid;
  // The title of the chat when Leo read it. It can be empty.
  string conversation_title;
  // The date of the message.
  mojo_base.mojom.Time date;
};

struct LearnedMemoryProposal {
  // The uuid of the memory, new or stored.
  string uuid;
  LearnedMemoryChange change;
  string text;
  // The stored text, for kChanged and kSeenAgain.
  string? stored_text;
  LearnedMemoryCategory category;
  LearnedMemoryType type;
  // The sentences of the run that the change came from.
  array<LearnedMemorySource> sources;
};

// A change of the review that the user keeps.
struct LearnedMemoryReviewDecision {
  string uuid;
  // The text that the user edited, or null to keep the text of the change.
  string? text;
};

// A memory that the semantic search found.
struct MemorySearchResult {
  string text;
  // The uuid of a learned memory. Null for a memory that the user wrote.
  string? learned_uuid;
};

enum DreamNowStatus {
  // The run processed all new user turns.
  kCompleted,
  // The run stopped at the time limit. Another run continues.
  kTimedOut,
  // A local model or the database failed.
  kFailed,
  // The database went away during the run.
  kCanceled,
  // Another run is active.
  kBusy,
  // Learned memory is not available, or the memory setting is off.
  kUnavailable,
  // The changes of the last run wait for the user's review.
  kReviewPending,
};

struct DreamNowResult {
  DreamNowStatus status;
  // The user turns that the run read, and the turns that the gate kept.
  uint32 turns_read;
  uint32 turns_kept;
  uint32 memories_added;
  // Same, replace and merge.
  uint32 memories_updated;
};

// Interface for settings UI -> browser communication. This interface allows
// managing user customization and memories.
interface CustomizationSettingsHandler {
  // Establishes a connection with the UI for browser -> UI notifications. This
  // creates a 1-to-1 connection between the handler and the settings UI.
  BindUI(pending_remote<CustomizationSettingsUI> ui);

  // Set customization values, note that all fields in Customization will be
  // updated to the provided value, old values should be provided if unchanged.
  // Each field can be set to empty if user intends to reset the field.
  SetCustomizations(Customizations customizations) =>
    (CustomizationOperationError? error);

  // Get all stored customization values.
  GetCustomizations() => (Customizations customizations);

  // Add a new memory if it is not existed yet. No duplicate would be added
  // if already exists.
  AddMemory(string memory) => (CustomizationOperationError? error);

  // Edit a specific memory. kNotFound would be returned if old_memory is not
  // found.
  EditMemory(string old_memory, string new_memory) =>
    (CustomizationOperationError? error);

  // Return all stored memories.
  GetMemories() => (array<string> memories);

  // Delete a specific memory.
  DeleteMemory(string memory);

  // Delete all stored memories.
  DeleteAllMemories();

  // Return the memories related to `query` by meaning, most related first:
  // the ones that the user wrote, and the learned ones. Empty when `query` is
  // too short to search, and null while semantic search is unavailable.
  SearchMemories(string query) => (array<MemorySearchResult>? results);

  // Learned memories. |available| is false when learned memory is off or the
  // chat database is not ready. Then |memories| is empty.
  GetLearnedMemories() =>
    (bool available, array<LearnedMemoryItem> memories);

  // Deletes a learned memory for good. Nothing remembers it, so Dreaming can
  // learn the same fact again from another chat.
  DeleteLearnedMemory(string uuid) => (bool success);

  // Deletes all learned memories for good, and stops a Dreaming run that is
  // active. Dreaming does not read the chats again that it already read, so it
  // learns only from new messages.
  DeleteAllLearnedMemories() => (bool success);

  // Changes the text of a learned memory. The memory keeps its sources and its
  // type, and the old text shows as "before". |error| is kInvalidLength when
  // the text is empty or too long, and kNotFound when the memory is not stored.
  EditLearnedMemory(string uuid, string text) =>
    (CustomizationOperationError? error);

  // Keeps a learned memory as it is (|permanent| true), or lets Dreaming change
  // it again (false). Dreaming never replaces or merges a permanent memory,
  // and Leo sends it in every chat. A memory that is not permanent any more is
  // long-term. |success| is false when the memory is not stored, or a write
  // failed.
  SetLearnedMemoryPermanent(string uuid, bool permanent) =>
    (bool success);

  // Starts a Dreaming run now, and replies when the run ends. The changes of
  // the run wait for the user's review (GetDreamingReview), and a new run does
  // not start before the review ends.
  DreamNow() => (DreamNowResult result);

  // The changes of the last Dreaming run that wait for the user's review.
  // Empty when none waits.
  GetDreamingReview() => (array<LearnedMemoryProposal> proposals);

  // Ends the review: stores the changes in |kept|, with their edited text, and
  // discards the others. |success| is false when no review waits, an edited
  // text is empty or too long (then the review stays), or a write failed.
  ApplyDreamingReview(array<LearnedMemoryReviewDecision> kept) =>
    (bool success);
};

// Interface for browser -> settings UI communication. This interface allows
// the browser process to notify the settings UI about changes to user
// customization and memories to ensures the UI stays in sync with the
// underline preference states.
interface CustomizationSettingsUI {
  OnCustomizationsChanged(Customizations customizations);
  OnMemoriesChanged(array<string> memories);
};
