import("//mojo/public/tools/bindings/mojom.gni")

if (is_ios) {
  import("//brave/build/ios/mojom/mojom_wrappers.gni")
}

mojom("mojom") {
  sources = [ "brave_transfer.mojom" ]
}

if (is_ios) {
  # ObjC value types and protocols (BraveTransfer.Device,
  # BraveTransferPageHandler, ...) for the iOS page handler bridge.
  ios_objc_mojom_wrappers("mojom_objc") {
    mojom_target = ":mojom"
    sources = [ "brave_transfer.mojom" ]
  }
}
