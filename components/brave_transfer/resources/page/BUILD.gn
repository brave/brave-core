import("//brave/components/common/typescript.gni")

transpile_web_ui("resources") {
  entry_points = [ [
        "brave_transfer",
        rebase_path("brave_transfer.tsx"),
      ] ]
  resource_name = "brave_transfer"
  imports_from = [ "//brave/components/brave_transfer/resources/page/" ]
  deps = [
    "//brave/components/brave_transfer/common:mojom_js",
    "//brave/components/resources:strings",
  ]
}

pack_web_resources("brave_transfer_page_generated") {
  resource_name = "brave_transfer"
  output_dir = "$root_gen_dir/brave/components/brave_transfer/resources/page"
  deps = [ ":resources" ]
}
