static_library("browser") {
  sources = [
    "pref_names.h",
    "skus_context_impl.cc",
    "skus_context_impl.h",
    "skus_service_impl.cc",
    "skus_service_impl.h",
    "skus_utils.cc",
    "skus_utils.h",
  ]

  public_deps = [ "rs/cxx:rust_lib" ]

  deps = [
    "//base",
    "//brave/components/skus/common",
    "//brave/components/skus/common:mojom",
    "//brave/services/network",
    "//components/keyed_service/core",
    "//components/pref_registry",
    "//components/prefs",
    "//mojo/public/cpp/bindings",
    "//mojo/public/rust/system:scoped_handle_interop_cc",
    "//net",
    "//services/network/public/cpp",
    "//services/preferences/public/cpp",
    "//url",
  ]
}

source_set("test_support") {
  testonly = true

  sources = [
    "test/fake_skus_service.cc",
    "test/fake_skus_service.h",
  ]

  public_deps = [
    "//brave/components/skus/common:mojom",
    "//mojo/public/cpp/bindings",
  ]
}

source_set("unit_tests") {
  testonly = true

  # skus_service_unittest.cc is the only end-to-end coverage of the SKU SDK's
  # HTTP path, which now runs over Mojo rather than a cxx shim. It was
  # previously win/mac only, for
  # https://github.com/brave/brave-browser/issues/15817. It is stable locally on
  # Linux, so please watch the Linux bots on this CL.
  sources = [
    "skus_service_unittest.cc",
    "skus_utils_unittest.cc",
  ]

  deps = [
    "//base",
    "//brave/components/skus/browser",
    "//brave/components/skus/common",
    "//brave/components/skus/common:mojom",
    "//components/prefs:test_support",
    "//components/sync_preferences:test_support",
    "//net:test_support",
    "//services/network:test_support",
    "//testing/gtest",
  ]
}
