module gestures.mojom;

import "ui/gfx/geometry/mojom/geometry.mojom";
import "url/mojom/url.mojom";

// The single piece of content found at a smart gesture's start point. A
// link and an image can overlap (e.g. an <img> inside an <a>); which one
// this resolves to in that case is decided once here, not left for callers
// to juggle.
union SmartGestureContent {
  url.mojom.Url link_url;
  url.mojom.Url image_url;
  string selected_text;
};

// Implemented in the renderer process, one instance per `RenderFrame`, to
// let the browser process find out what's at a point on the page -- a link,
// an image, or the page's current text selection -- for a smart gesture's
// start point, without needing a full page content extraction.
interface SmartGestureContentExtractor {
  // Null if there's no link, image, or text selection at `point`.
  GetContentAtPoint(gfx.mojom.PointF point) => (SmartGestureContent? content);
};
