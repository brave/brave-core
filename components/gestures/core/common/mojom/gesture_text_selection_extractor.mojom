module gestures.mojom;

// Implemented in the renderer process, one instance per `RenderFrame`, to
// let the browser process read that frame's current text selection for a
// gesture action (e.g. "search selected text") without needing a full page
// content extraction.
interface GestureTextSelectionExtractor {
  // The frame's currently selected text, or an empty string if nothing is
  // selected.
  GetSelectedText() => (string selected_text);
};
