static_library("browser") {
  public = [
    "mouse_rocker_default_commands_info.h",
    "mouse_wheel_default_commands_info.h",
    "pref_names.h",
    "prefs_registration.h",
  ]

  sources = [ "prefs_registration.cc" ]

  deps = [
    "//base",
    "//brave/components/gestures/core/common",
    "//brave/components/gestures/core/common:features",
    "//components/pref_registry",
    "//components/prefs",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "test/fake_mouse_rocker_wheel_default_commands.cc",
    "test/fake_mouse_rocker_wheel_default_commands.h",
  ]

  public_deps = [ ":browser" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "prefs_registration_unittest.cc" ]

  deps = [
    ":browser",
    ":test_support",
    "//base",
    "//brave/components/gestures/core/common",
    "//brave/components/gestures/core/common:features",
    "//components/pref_registry",
    "//components/sync_preferences:test_support",
    "//testing/gtest",
  ]
}
