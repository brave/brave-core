import("//brave/components/ai_chat/core/common/buildflags/buildflags.gni")
import("//brave/components/commander/common/buildflags/buildflags.gni")

brave_chromium_src_chrome_browser_autocomplete_public_deps = [
  "//brave/components/ai_chat/core/common/buildflags",
  "//brave/components/commander/common/buildflags",
]

if (enable_commander) {
  brave_chromium_src_chrome_browser_autocomplete_public_deps +=
      [ "//brave/components/commander/browser" ]
}

brave_chromium_src_chrome_browser_autocomplete_impl_deps =
    [ "//brave/browser/autocomplete" ]

if (enable_ai_chat) {
  brave_chromium_src_chrome_browser_autocomplete_impl_deps += [
    "//brave/browser/ai_chat",
    "//brave/components/ai_chat/content/browser",
    "//brave/components/ai_chat/core/browser",
    "//brave/components/ai_chat/core/common",
  ]
}

if (!is_android) {
  brave_chromium_src_chrome_browser_autocomplete_impl_deps += [
    "//brave/browser/misc_metrics",
    "//brave/browser/ui/sidebar",
  ]
}

if (enable_commander) {
  brave_chromium_src_chrome_browser_autocomplete_impl_deps +=
      [ "//brave/browser/ui/commander" ]
}
