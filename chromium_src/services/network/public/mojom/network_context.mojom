module network.mojom;

[BraveExtend]
struct NetworkContextParams {
  // Whether host resolution of .onion hostnames fails. Blocked by default so
  // that only contexts the embedder explicitly allows can send .onion names
  // to a DNS resolver.
  bool block_onion_hostname_resolution = true;
};

[BraveExtend]
interface NetworkContext {
  // Sets whether host resolution of .onion hostnames fails.
  SetBlockOnionHostnameResolution(bool block);
};
