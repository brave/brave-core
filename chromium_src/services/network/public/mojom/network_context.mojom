module network.mojom;

// How a network context treats Tor and .onion hostnames. Mirrors
// net::URLRequestContext::TorMode. Builds without Tor ignore it and never
// block .onion.
[BraveAdd]
enum TorMode {
  // The context belongs to a Tor profile. .onion requests go through the Tor
  // proxy, so the host resolver does not block them.
  kEnabled,
  // The context is not Tor. .onion lookups fail before they reach the system
  // resolver or DoH.
  kDisabled,
};

[BraveExtend]
struct NetworkContextParams {
  // kDisabled by default so that only contexts the embedder marks as Tor can
  // send .onion names to a DNS resolver.
  TorMode tor_mode = TorMode.kDisabled;
};
