# Generated by `bots.py snapshot` from the `android_defaults` config in
# infra/config/gn_args.py; do not edit.

# This file contains defaults for gn values in Chromium which are always
# overridden in Brave builds. This file in particular is only included in builds
# for android

safe_browsing_mode = 2

# Fixes WebRTC IP leak with default option
enable_mdns = true

# We want it to be enabled for all configurations
disable_android_lint = false

# Compile the extensions core on Android. Runtime use is gated by the
# BraveAndroidExtensions feature, so this only controls whether the code is in
# the APK.
enable_extensions_core = true
