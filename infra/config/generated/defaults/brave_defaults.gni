# Generated by `bots.py snapshot` from the `brave_defaults` config in
# infra/config/gn_args.py; do not edit.

# This file contains strict overrides for gn values in Chromium which we always
# override in Brave builds.

# Please provide a reason if you are adding new overrides to this file.

disable_fieldtrial_testing_config = true
root_extra_deps = [ "//brave" ]

# Chromium_src overrides do not work with precompiled headers.
enable_precompiled_headers = false

enable_pseudolocales = false

# Our copy of signature_generator.py doesn't support --ignore_missing_cert:
ignore_missing_widevine_signing_cert = false

# Brave doesn't report activity via //components/activity_reporter. The value
# upstream is currently gated on is_chrome_branded, but if that ever changes we
# want to make sure no reporting to the Google endpoint can happen.
report_activity = false
